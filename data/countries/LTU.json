{
  "iso3": "LTU",
  "name": "Lithuania",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "social_health_insurance",
    "label": "Single national compulsory health insurance fund (NHIF) financed by payroll contributions plus a state-budget contribution for people insured by the state; high out-of-pocket spending"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "LTU-overview-001",
      "LTU-overview-002"
    ],
    "meets_definition": true
  },
  "sections": {
    "overview": [
      {
        "id": "LTU-overview-001",
        "statement": "Lithuania funds health care mainly through a mandatory health insurance scheme run by the National Health Insurance Fund (NHIF), with payroll contributions from workers and government budget transfers for people outside work; about 99% of residents were covered in 2022.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 8,
          "char_start": 44171,
          "char_end": 44537,
          "passage_sha256": "d3a3832811e6203a8ea13176dddd052ef088bfa9fed4de33785c7ae21e20d658"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LTU-overview-002",
        "statement": "About 99% of residents are in the mandatory scheme; in 2024 roughly 53% of those covered paid contributions themselves, while the state paid for the rest, mostly pensioners and children but also registered unemployed people and a few other groups.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 13,
          "char_start": 82103,
          "char_end": 82452,
          "passage_sha256": "a59ce38acba06ad2d904edd5ea1cb6aba260712ed194b170c4be9c63c9f09bab"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-overview-003",
        "statement": "The Ministry of Health sets policy and regulation and governs the NHIF; it co-owns some providers, including all tertiary hospitals, while municipalities own publicly financed primary care centres and most district and nursing hospitals.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 8,
          "char_start": 44538,
          "char_end": 45052,
          "passage_sha256": "a412052c2c372f9112f5c376e03f443e9ce1f59eb04f81290ea39d52ef9daa6f"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LTU-overview-004",
        "statement": "Private provision is limited in inpatient care but common in outpatient specialist services, notably dental care; many family doctors work privately, and the NHIF routinely contracts private providers for primary and some specialised outpatient care.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 8,
          "char_start": 45053,
          "char_end": 45395,
          "passage_sha256": "6b0a2c86fa0d9c05354526ccac2ff31471fcab777bf0b7f851e1bdb6b27042f1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "financing": [
      {
        "id": "LTU-financing-001",
        "statement": "For people insured by the state, the state budget pays a per-person contribution into the compulsory health insurance fund; since 2021 it has been set at 6.98% of the annual minimum wage from two years earlier, and it rose from EUR 465 per person in 2021 to EUR 774 in 2026, with EUR 1,003 set for 2027.",
        "valence": "neutral",
        "source_id": "hspm-ltu-shi",
        "locator": {
          "section": "Full text",
          "char_start": 1362,
          "char_end": 1667,
          "passage_sha256": "8e4801ad6c2b9e719cc9b211938d6715f9548a5e5cb09ac8818e427c71c771b6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LTU-financing-002",
        "statement": "Amendments passed in December 2025 set the 2027 state contribution at 50% of the average annual contribution of a working person from two years earlier, rising each year by five percentage points up to 75%.",
        "valence": "neutral",
        "source_id": "hspm-ltu-shi",
        "locator": {
          "section": "Full text",
          "char_start": 2983,
          "char_end": 3295,
          "passage_sha256": "b57be057fdb263bd98c73aab0564ccbe56ba4798936ea5770382b284e9eae5d8"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LTU-financing-003",
        "statement": "Public sources paid 68% of health spending in 2023, in line with pre-pandemic levels; out-of-pocket payments were 31.0% and voluntary health insurance only 1.6%.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 8,
          "char_start": 46150,
          "char_end": 46418,
          "passage_sha256": "cda59badeecb3710692412c596e1c2bbe61979630b51b0e8749719c88c1a235c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LTU-financing-004",
        "statement": "Public health spending was 14.1% of total government spending in 2023, just under the EU average of 14.8%.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 8,
          "char_start": 46580,
          "char_end": 46762,
          "passage_sha256": "97261b8cdcb537c82f30a5788f50d11a36453b96e4f895d8e44e2e5e66a1d700"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LTU-financing-005",
        "statement": "Public health spending is forecast to stay at around 5% of GDP or slightly under until at least 2027.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 16,
          "char_start": 111068,
          "char_end": 111168,
          "passage_sha256": "1f95ba4e0ffc4ac0866848f7b35892a97de956b0a3b46fab5a77d051e46892e7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2027
      }
    ],
    "covered": [
      {
        "id": "LTU-covered-001",
        "statement": "The benefits package, delivered by public and private providers contracted by the NHIF, includes free preventive care, primary, secondary and tertiary services, medical rehabilitation and nursing care; copayments apply to medicines, medical products and primary-care dental treatment unless a person belongs to an exempt group.",
        "valence": "strength",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 90473,
          "char_end": 90838,
          "passage_sha256": "45327065069e00e7796624c075dc9d1507851064ecf8d8ec2ee7ee55fb5b573e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LTU-covered-002",
        "statement": "Registered Ukrainian refugees are entitled to health coverage at the same level as residents.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 13,
          "char_start": 82453,
          "char_end": 82567,
          "passage_sha256": "8d53ad0ee8f200c24313bbc0bf02fb1c8c9f6a5d0371deab1539da800c253404"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LTU-covered-003",
        "statement": "Only about half (51%) of spending on medicines was publicly financed in 2023, against 59% across the EU.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 91038,
          "char_end": 91148,
          "passage_sha256": "7c78d7043be51e014a94238fd10dc9c678e1a2672bac3bb37a4ed3872b08329c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "cost_sharing": [
      {
        "id": "LTU-cost_sharing-001",
        "statement": "Since July 2020 people aged 75 and over, low-income people with disabilities and low-income pensioners under 75 are exempt from copayments on prescribed reimbursed outpatient medicines.",
        "valence": "strength",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 92788,
          "char_end": 93059,
          "passage_sha256": "54b6f13f83acb050120971ab9ac545d7bdb055143a03fccbf03f903e44ba1779"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      },
      {
        "id": "LTU-cost_sharing-002",
        "statement": "An automatic annual cap on medicine copayments was introduced in 2023 (EUR 59.04 in 2025, beyond which the state budget pays if the cheapest reimbursed option is chosen); average copayments per person on prescribed reimbursed medicines rose from EUR 7.28 in 2023 to EUR 9.08 in 2024, about half the 2016 level.",
        "valence": "strength",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 15,
          "char_start": 100594,
          "char_end": 101051,
          "passage_sha256": "4cb2d9766b17b47fe127414e26abaaae49da6e4294d6111fa96604decdc06833"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LTU-cost_sharing-003",
        "statement": "The positive list of reimbursed medicines was gradually consolidated, which removed all percentage copayments.",
        "valence": "strength",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 93082,
          "char_end": 93204,
          "passage_sha256": "9baa845446209556730041641179d0037bce61fdafe677c1afcad914d54e6e14"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      },
      {
        "id": "LTU-cost_sharing-004",
        "statement": "Current rules let providers charge patients extra for publicly financed services when the patient picks costlier materials or procedures than the NHIF covers, especially in private provision; in 2025 the Ministry of Health proposed banning such surcharges for insured services.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 92030,
          "char_end": 92648,
          "passage_sha256": "bf9e0b1312e02e5da98a6076873dfe534769f27f082f0f2063f0543feb9dbddf"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LTU-cost_sharing-005",
        "statement": "Medicines accounted for a third of out-of-pocket payments in 2023, closely followed by dental care, whereas in 2016 medicines were nearly 60% of out-of-pocket spending.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 91836,
          "char_end": 92012,
          "passage_sha256": "ac50f045c50042cc82295a5356464331d9df6cd1b4859ccf71d096ea42bbd16c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "financial_hardship": [
      {
        "id": "LTU-financial_hardship-001",
        "statement": "Catastrophic spending attributable to medicines fell substantially between 2016 and 2021 among the poorest households and among older people.",
        "valence": "strength",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 15,
          "char_start": 101200,
          "char_end": 101339,
          "passage_sha256": "783e61c271d35205d0c48d0c751f5e5009eacab19bc3aff151f651d070d0b3da"
