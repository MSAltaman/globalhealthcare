          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "outcomes": [
      {
        "id": "LTU-outcomes-001",
        "statement": "Life expectancy at birth was 77.6 years in 2024, 4.1 years below the EU average, but Lithuania gained 4.3 years between 2010 and 2024, the largest increase in the EU.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 3,
          "char_start": 4499,
          "char_end": 4725,
          "passage_sha256": "97d842d69162486b18c95251757d7cd855fbb60abdeaa5c7139d4bfa0d7fb810"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-outcomes-002",
        "statement": "In 2024 Lithuanian women's life expectancy was 81.9 years, 8.8 years longer than men's (73.1).",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 4,
          "char_start": 14029,
          "char_end": 14140,
          "passage_sha256": "0380f2241df4d04bdc049f03292d167c416f1f0423bfebcaa5136de7e16261a7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-outcomes-003",
        "statement": "Lithuania had the EU's fourth highest avoidable mortality rate in 2022, driven mainly by premature deaths from ischaemic heart disease.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 3,
          "char_start": 6422,
          "char_end": 6573,
          "passage_sha256": "44359de3080bb122b0bb34c8749850a507de9bce613975bcd2517498beb7a574"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LTU-outcomes-004",
        "statement": "Cardiovascular disease caused 53% of all deaths (EU average 33% in 2022) and cancer 21% (EU 22%).",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 4,
