          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-covered-003",
        "statement": "At the end of 2023 about 0.8% of people eligible for coverage (17,876) were not fully covered because they had not paid mandatory contributions, and 0.3% (5,666) had been in that position for over a year.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.1 Population coverage",
          "page": 27,
          "char_start": 43022,
          "char_end": 43270,
          "passage_sha256": "a8530806ced8e2f463919094fd496887c09e353df7aff3c69a2eba007b403b5e"
        },
        "verification": {
