        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2019
      },
      {
        "id": "URY-covered-002",
        "statement": "The mental health benefit plan's psychotherapy cover was extended in 2024 to people up to 30 years old inclusive.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
