        },
        "data_year": 2024
      },
      {
        "id": "HRV-access-004",
        "statement": "Waiting times for some diagnostic and treatment procedures are long in some hospitals, more than 10 months, and differ greatly between hospitals.",
        "valence": "weakness",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Hospital care",
