        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-cost_sharing-004",
        "statement": "A 2020 study found that the reform regulated moderation fees for all services in the PIAS, but premiums and copayments remained scarcely regulated at for-profit private insurers and at the mutual providers for non-PIAS services and voluntary amenities, so those remain unequally accessible.",
        "valence": "weakness",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 35500,
          "char_end": 35792,
          "passage_sha256": "2b8bf9a29c0b1200cca7485e41415c178ab85147aee3156fb0721835b31acfa1"
