        "data_year": 2024
      },
      {
        "id": "HRV-cost_sharing-004",
        "statement": "Retail pharmaceuticals made up 49% of out-of-pocket spending in 2023 (EU 26%) and dental care 20% (EU 12%).",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
