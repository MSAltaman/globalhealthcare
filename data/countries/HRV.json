          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "HRV-access-003",
        "statement": "Rural travel distances to health facilities average 21.8 km against 14.4 km in the EU, and in 2024 a larger share of Croatians (0.7%) than in any other EU country reported unmet need because of distance.",
        "valence": "weakness",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 5.2",
          "page": 15,
          "char_start": 94190,
          "char_end": 94482,
