        },
        "data_year": 2018
      },
      {
        "id": "ECU-access-004",
        "statement": "Under the network's referral rules, providers send patients to an external provider when they lack the capacity to treat them or geographic access is limited.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Ilustración 2",
          "page": 6,
