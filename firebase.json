{
  "hosting": [
    {
      "target": "atlas",
      "public": "site",
      "ignore": ["firebase.json", "**/.*"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.@(html|json|js)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
        },
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    }
  ]
}
