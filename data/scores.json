    {
      "domain": "Equity",
      "reason": "Needs comparable data on gaps between income groups for every country."
    },
    {
      "domain": "Access and timeliness",
      "reason": "Needs comparable waiting-time and unmet-need data beyond the EU and the Commonwealth Fund's 10 countries."
    },
    {
      "domain": "Efficiency",
      "reason": "Shown separately as the score against spending per person, not folded into the score, so cost and performance can be read apart."
    }
  ],
  "excluded_countries": {
