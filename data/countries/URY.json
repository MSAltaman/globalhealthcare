  "sections": {
    "overview": [
      {
        "id": "URY-overview-001",
        "statement": "The National Integrated Health System (SNIS) was created by Law 18,211 of December 2007; it integrates public and private providers and is financed through the National Health Fund (FONASA), a single mandatory public fund.",
        "valence": "neutral",
        "source_id": "paho-func-ury",
        "locator": {
          "section": "see page",
          "page": 2,
          "char_start": 431,
          "char_end": 640,
          "passage_sha256": "510895d5f07adff4d725b0f6a3dc58535822cce42a247aad0bba5a6429cbe48e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2021
      },
      {
        "id": "URY-overview-002",
        "statement": "At the end of 2024 the National Health Insurance covered 2,681,295 people, roughly three quarters of the national population.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 15,
          "char_start": 19711,
          "char_end": 19879,
          "passage_sha256": "22d7f424f901803c8e47e996f81602aefa73557f884bf5d2fd41ca87800d7f36"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-overview-003",
        "statement": "In December 2024 the mutual non-profit providers (IAMCs) held 74.6% of the insured population in the National Health Insurance register, the state provider ASSE 21.9% and private integral insurers 3.4%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 11,
          "char_start": 22142,
          "char_end": 22727,
          "passage_sha256": "7831abd584de3ab039e02523f6ec6c0175cf318c4001dc67f41bd0a83e580aff"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-overview-004",
        "statement": "The SNIS ensures universal coverage through 42 eligible comprehensive health providers, which deliver the Comprehensive Health Care Plan (PIAS), a broad benefits plan that is the same for all.",
        "valence": "neutral",
        "source_id": "paho-func-ury",
        "locator": {
          "section": "see page",
          "page": 2,
          "char_start": 768,
          "char_end": 994,
          "passage_sha256": "0852f25c0896bebe8dbf7979559f1d1e3e5d596dc5b9a8a26be3a48b4da3c2a9"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2021
      }
    ],
    "financing": [
      {
        "id": "URY-financing-001",
        "statement": "FONASA obligations consist of personal contributions that vary with pay and family situation, an employer contribution at a 5% rate, and, where applicable, a supplementary mutual-fee payment (CCM) by the employer.",
        "valence": "neutral",
        "source_id": "bps-tasas-fonasa",
        "locator": {
          "section": "see page",
          "char_start": 151,
          "char_end": 396,
          "passage_sha256": "c5c6a4a517107f7f2f1028f5ea5586f8378b5368191e40bd5201c108c97def48"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2026
      },
      {
        "id": "URY-financing-002",
        "statement": "Employees pay a basic 3% personal rate plus an additional rate set by pay band and family situation. For pay up to 2.5 BPC the total is 3% or 5% (5% with a spouse or partner who lacks their own SNIS cover); above 2.5 BPC it ranges from 4.5% to 8% depending on spouse and children.",
        "valence": "neutral",
        "source_id": "bps-tasas-fonasa",
        "locator": {
          "section": "see page",
          "char_start": 538,
          "char_end": 1239,
          "passage_sha256": "730899d4669c6810024eb33e029fc31b3cb1bfa34d9be62e24f2c6fab65ddade"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2026
      },
      {
        "id": "URY-financing-003",
        "statement": "In 2024 FONASA's own income (contributions and other receipts) was 78.1% of its total revenue of about 147.7 billion pesos; a transfer from general revenue supplied the other 21.9%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 21,
          "char_start": 40831,
          "char_end": 40992,
          "passage_sha256": "873e880f4c819a9b9ddc04209bd6f5c9e069e853449a45c434e9507320051b97"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-004",
        "statement": "Of FONASA's own income in 2024, about 43.4% came from personal contributions of private- and public-sector employees (excluding banking, notarial and self-employed contributors), a little over 36% from employer contributions and mutual-fee complements, and 12.6% from contributions by retirees and pensioners.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 21,
          "char_start": 40993,
          "char_end": 41874,
          "passage_sha256": "4fb61a988391040039414400980356bf6b6bfbcd8d36b72df07c189154d89c25"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-005",
        "statement": "Government schemes and compulsory contributory insurance together financed 72.6% of total health spending in 2023 and 73.7% in 2024.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 13,
          "char_start": 16162,
          "char_end": 16278,
          "passage_sha256": "6f5131429b07d829be16f65beafabce99f38a92f2311ba8cbcacc018b56c3798"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-006",
        "statement": "In 2024 capitation payments made up 75.4% of FONASA outlays and the goals-linked payment (Meta) 4.9%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 22,
          "char_start": 42443,
          "char_end": 42496,
          "passage_sha256": "7d93d20df571f63bbc8f70f5bd1f5c354343f6e373fdd99ac31a1575664190f1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-007",
        "statement": "Social insurance schemes channelled through FONASA and the National Resources Fund (FNR), which finance the PIAS and higher-complexity, higher-cost benefits, explained over 52% of total health spending in 2024, a pattern seen since 2016.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 13,
          "char_start": 16715,
          "char_end": 16962,
          "passage_sha256": "e98d423aef578f80c8d32858136b2d5243923832b40a178c9131e6640465ceed"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-008",
        "statement": "A 2020 study reported that FONASA allocates resources to providers by a calculation of health risk, rather than by the contribution amounts negotiated by occupational groups with the mutual providers as before the reform.",
        "valence": "neutral",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 30912,
          "char_end": 31118,
          "passage_sha256": "88601235fe6e25abc6907d9c155bc78e3bb6d0cf6aa755661f1169a858e63ed8"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2019
      }
    ],
    "covered": [
      {
        "id": "URY-covered-001",
        "statement": "A 2020 comparative study found that all SNIS providers must guarantee the Comprehensive Benefit Plan, which sets the same comprehensive benefits for the entire population.",
        "valence": "neutral",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 34826,
          "char_end": 35080,
