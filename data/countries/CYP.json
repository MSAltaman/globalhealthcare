{
  "iso3": "CYP",
  "name": "Cyprus",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "single_payer_insurance",
    "label": "Single-purchaser national health insurance funded by income contributions and state revenue, with public and private providers contracted by one insurer"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "CYP-overview-001",
      "CYP-overview-003"
    ],
    "meets_definition": true
  },
  "sections": {
    "overview": [
      {
        "id": "CYP-overview-001",
        "statement": "Cyprus introduced its General Healthcare System (GeSY) in 2019. It gives near-universal coverage through a mix of public and private providers and is financed from state revenue plus contributions on wages, incomes and pensions.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 8,
          "char_start": 45015,
          "char_end": 45390,
          "passage_sha256": "e9b60563fbbef3a20aa425bad746529d8a22c7d42597ccc93dca150c1ebedf47"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "CYP-overview-002",
        "statement": "Before GeSY, only about three quarters of the population had statutory coverage, and many people relied on out-of-pocket payments or private insurance.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 8,
          "char_start": 45392,
          "char_end": 45607,
          "passage_sha256": "4fbc7ec4b1c13133660671b2e304eb5e5dea14d92e5daab0c311e12e3f377dff"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2018,
        "historical": true
      },
      {
        "id": "CYP-overview-003",
        "statement": "Coverage under GeSY is based on legal residence, not on citizenship, income or payment of contributions.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 4571,
          "char_end": 4711,
          "passage_sha256": "74d5d6db0554f79598115e5d45c31ecf0cf384a81ba5199750690ff70a245fff"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-overview-004",
        "statement": "The Health Insurance Fund is run exclusively by the Health Insurance Organisation (HIO), which is also the only body that contracts and pays for GeSY services.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 12320,
          "char_end": 12446,
          "passage_sha256": "a9d9432523890a776946eb0f795518057b5d8ede7a66ef0b601f541ed909937e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-overview-005",
        "statement": "Public providers are overseen by the State Healthcare Services Organisation, while the Ministry of Health has a strategic oversight role; private clinics, laboratories, pharmacies and hospitals also provide care in a competitive provider market.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 8,
          "char_start": 45687,
          "char_end": 46233,
          "passage_sha256": "071403f5f52822b1ed05b09bd4d205d8ff457573b111dfce136a1619bbd37608"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "financing": [
      {
        "id": "CYP-financing-001",
        "statement": "Since 1 July 2020 GeSY has been funded by full income-based contributions from salaried employees, the self-employed, income-earners and pensioners, plus employers and the state budget, under Law 74(I)/2017.",
        "valence": "neutral",
        "source_id": "hspm-cyp-sources",
        "locator": {
          "section": "see source",
          "char_start": 3213,
          "char_end": 3487,
          "passage_sha256": "046e62ab1943049dc2e97bf70c45c416dbd7434a119ee47881c601a27a4dd023"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-financing-002",
        "statement": "Contribution rates on gross income are 2.65% for employees, pensioners, government officials and income-earners, 2.90% for employers, and 4.00% for the self-employed; the state adds 4.7% for each employee, self-employed person, government official and pensioner.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 11305,
          "char_end": 11605,
          "passage_sha256": "a84c089562a28bbaf905fa0bb680f3f4afd7f8984f95ceee7ba438c020365340"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-financing-003",
        "statement": "Contributions are charged only on gross income up to a ceiling of EUR 180,000 a year.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 11607,
          "char_end": 11692,
          "passage_sha256": "3f3ba5f3069f345cd4222ca3127ca13897d673bb73a58664aedbd315984d442b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-financing-004",
        "statement": "Unemployed people and recipients of Guaranteed Minimum Income or public assistance are covered without paying formal contributions, once their status is certified by the relevant welfare services.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 4925,
          "char_end": 5239,
          "passage_sha256": "828153ef939bd9239a0043b152a717a57245fd0c9a7093d4b0ca227f2d06b975"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-financing-005",
        "statement": "In 2024 the Health Insurance Fund took in EUR 1,839 million and spent EUR 1,726 million, a surplus of EUR 113 million, leaving accumulated reserves of EUR 707 million, about 4.6 months of payments (unaudited figures).",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 3001,
          "char_end": 3199,
          "passage_sha256": "3e428e0c509d0cd7068f326712ee9fc478ad0ab4125ff47e3a30c1dd8fc718a2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-financing-006",
        "statement": "In 2023 public sources paid 77% of health expenditure and out-of-pocket payments 18%, compared with 42% public and 44% out-of-pocket in 2018, the last year before GeSY.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 9,
          "char_start": 49302,
          "char_end": 49865,
          "passage_sha256": "63563c35130d46259fce9a9766d7984790c42b46e400319aa61996ddb7361799"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "CYP-financing-007",
        "statement": "Cyprus offers no tax incentives or disincentives for taking up voluntary health insurance, so there is no hidden tax subsidy for private cover.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 81,
          "char_start": 158315,
          "char_end": 158384,
          "passage_sha256": "d1147ee3898501368210a6194ee7295624cc69893c88c83ca9de3b89495086a0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-financing-008",
        "statement": "An actuarial study by the International Labour Organization projected that the system stays financially viable until 2031, with reserves of about EUR 590 million as of 2023.",
        "valence": "neutral",
        "source_id": "hspm-cyp-5yr",
        "locator": {
          "section": "see source",
          "char_start": 1004,
          "char_end": 1199,
          "passage_sha256": "17ea2444fb5d7968f03aae02c304b7e76eff502c44d9d8fad6cb3ca05eb506fe"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "covered": [
      {
        "id": "CYP-covered-001",
        "statement": "The benefit package is comprehensive and the same for all beneficiaries; it is set out in Law 74(I)/2017 and in HIO regulations and guidelines.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 7249,
          "char_end": 7537,
          "passage_sha256": "d6836e13d806c466f22288fdd3b9345ab8a44e235f7b17b61af220f252f19122"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-covered-002",
        "statement": "Covered services include personal and specialist doctors, laboratory tests and diagnostics, and medicines, devices and supplies prescribed from the positive lists.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 7731,
          "char_end": 8110,
          "passage_sha256": "6daf7eb38ba316b88455c2142e1c78e573cf55275ebafd47557295f86bd507fb"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-covered-003",
        "statement": "The package also includes nursing and midwifery care, palliative care, inpatient care, limited preventive dental care, medical rehabilitation, home care and emergency care including ambulance services.",
        "valence": "neutral",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 8315,
          "char_end": 8721,
          "passage_sha256": "2967c513b46598627a376390cb8b325dcccf26632bd4dc03681f1523bbe21a10"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-covered-004",
        "statement": "GeSY does not cover chronic psychiatric institutional or compulsory care, substance-abuse rehabilitation, or mental health rehabilitation services such as day care centres.",
        "valence": "weakness",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 8723,
          "char_end": 9011,
          "passage_sha256": "ad840a3f7edb46ba8bd786f2d563e06dbffa78bad3c43c787da9c6290d3f2e60"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "CYP-covered-005",
        "statement": "Asylum seekers are not covered by GeSY; they are instead entitled to free care from public hospitals and health centres run by the State Healthcare Services Organisation.",
        "valence": "weakness",
        "source_id": "hspm-cyp-stat",
        "locator": {
          "section": "see source",
          "char_start": 5608,
          "char_end": 5765,
          "passage_sha256": "74709d1600633947cfc859d08a616f27aaa17425a7d58255b2c475670337aa73"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      }
    ],
    "cost_sharing": [
      {
        "id": "CYP-cost_sharing-001",
        "statement": "GeSY has two kinds of user charge, co-payments and personal contributions, with annual caps that are lower for low-income groups and full exemption for some vulnerable groups.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 78,
          "char_start": 151612,
          "char_end": 152063,
          "passage_sha256": "3f3b49ff02176afc4aa37a2d17efb964dc659c650dc77a9dd1f19072376fb93b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-cost_sharing-002",
        "statement": "An outpatient specialist visit costs EUR 6 with a referral and EUR 25 without one. Annual caps are EUR 75 for Guaranteed Minimum Income recipients, low-income pensioners and people under 21, and EUR 150 for everyone else.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 79,
          "char_start": 153303,
          "char_end": 153614,
          "passage_sha256": "21d8b85772a2691f942b5e590748c509efe8ee10bab589afbc18c926e8f96549"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-cost_sharing-003",
        "statement": "Primary care visits carry a EUR 15 co-payment only once the age-group limit on annual visits has been exceeded, and inpatient stays have no user charge.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 79,
          "char_start": 153114,
          "char_end": 153208,
          "passage_sha256": "40ababd687dbb469ed2567b4dc941df3aaf18317c5d5f496edb1b2a7401109d1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-cost_sharing-004",
        "statement": "Public funding covered only 15% of dental care spending in Cyprus in 2023, against 35% across the EU.",
        "valence": "weakness",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 14,
          "char_start": 83898,
          "char_end": 84019,
          "passage_sha256": "1c9394ef45d4524050068bc7631b8ee91441839ea3007c52091ace299f6a6f8d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "financial_hardship": [
      {
        "id": "CYP-financial_hardship-001",
        "statement": "Data on catastrophic health spending in Cyprus have not been updated since 2015.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 14,
          "char_start": 84789,
          "char_end": 84855,
          "passage_sha256": "69fa602a594a796ee446d7dac693fdaae6744114feabd262d412e1c9510cb809"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "CYP-financial_hardship-002",
        "statement": "Under the pre-GeSY system, 5.0% of households had catastrophic out-of-pocket health payments in 2015, including 17% of those in the poorest quintile against under 2% in the richest.",
        "valence": "weakness",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 147,
          "char_start": 294588,
          "char_end": 295110,
          "passage_sha256": "f2dacdde268bcb1ad29aafe09afb509483c10610e4ec4c5d82f87982a27abbb6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2015,
        "historical": true
      },
      {
        "id": "CYP-financial_hardship-003",
        "statement": "The Patients' Rights Observatory's complaints in 2023 were mostly about medication shortages and costs (32%), barriers to accessing services (19%), poor professional behaviour (17%) and unexpected healthcare expenditure (14%).",
        "valence": "weakness",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 15,
          "char_start": 91216,
          "char_end": 91440,
          "passage_sha256": "abd3116a566621d45841f281c4d1daa74131bcfff3a5b66786cd831c55b8385d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "additional_care": [
      {
        "id": "CYP-additional_care-001",
        "statement": "Voluntary health insurance paid for 5% of health spending in 2023, down from a peak of 14% in 2018, which the Observatory links to GeSY's broad benefits package reducing the need for supplementary plans.",
        "valence": "neutral",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 9,
          "char_start": 49867,
          "char_end": 50134,
          "passage_sha256": "d2381358c624b24aad8dae072c2c4082996226bfe12e568b1d5cfb9adba8e118"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "CYP-additional_care-002",
        "statement": "Group health insurance bought by large employers was either dropped once GeSY contributions began or reshaped as a supplement for services the public system does not provide or covers only partly.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 81,
          "char_start": 157834,
          "char_end": 158155,
          "passage_sha256": "4e48b069800d89565644c0a4b233a107f35050e2b3df7f59737020b207c8086f"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-additional_care-003",
        "statement": "A few private doctors, hospitals and clinics stay outside GeSY, serving non-beneficiaries and GeSY beneficiaries who pay privately or through insurance, often to avoid waiting lists or for perceived better quality.",
        "valence": "neutral",
        "source_id": "hit-cyp-2024",
        "locator": {
          "section": "see source",
          "page": 81,
          "char_start": 159498,
          "char_end": 159976,
          "passage_sha256": "640122e7dbd53b8c9cb04eabfc7e4b56424844e58167e70e4d70115e51d04a46"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "access": [
      {
        "id": "CYP-access-001",
        "statement": "In 2024 only 0.1% of respondents who needed medical care could not get it because of cost, distance or waiting times; among people at risk of poverty the figure was 0.5%, the lowest in the EU.",
        "valence": "strength",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 13,
          "char_start": 80941,
          "char_end": 81258,
          "passage_sha256": "b21334fc933bb0d8f9eb0dbc287a68e90ba4a79754f5e67c13f33134085fe355"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-access-002",
        "statement": "Unmet need for dental care among people who needed it was 2.4% overall and 7.9% among those at risk of poverty in 2024, both below the EU averages of 6.3% and 13.6%.",
        "valence": "weakness",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 13,
          "char_start": 81260,
          "char_end": 81494,
          "passage_sha256": "46ce7fb78b59c1b6d13cc693439b3ad772ff60e7451bfc7fb886357fe128ba18"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "CYP-access-003",
        "statement": "Gaps in provider availability still keep people from some entitlements, especially long-term care, rehabilitation, physiotherapy, speech therapy and home care for patients with chronic conditions.",
        "valence": "weakness",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 14,
          "char_start": 85249,
          "char_end": 85748,
          "passage_sha256": "7e515720d670d25842c4fe39949d7f7aae03e26f8807178fe965faf2946ff044"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "outcomes": [
      {
        "id": "CYP-outcomes-001",
        "statement": "Life expectancy at birth in Cyprus was 83.2 years in 2024, 1.6 years above the EU average.",
        "valence": "strength",
        "source_id": "chp-cyp-2025",
        "locator": {
          "section": "see source",
          "page": 4,
          "char_start": 13764,
          "char_end": 13866,
          "passage_sha256": "4a6ca5875543f896f3e26317e92be6e8af9069a70393e9cd9806f0c5bddb0604"
