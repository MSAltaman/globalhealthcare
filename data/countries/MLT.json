        },
        "data_year": "2011-2020"
      }
    ],
    "costs": [
      {
        "id": "MLT-costs-001",
        "statement": "Current health spending per person was EUR 3,563 in 2023 (EU average EUR 3,832) and 8.8% of GDP (EU average 10.0%).",
        "valence": "neutral",
        "source_id": "chp-mlt-2025",
        "locator": {
          "section": "costs",
          "page": 9,
          "char_start": 49785,
          "char_end": 50050,
          "passage_sha256": "d966b8307c9039547bb903650f4193e50b024a705501228e0926e72196698f6e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-24"
        },
        "data_year": 2023
