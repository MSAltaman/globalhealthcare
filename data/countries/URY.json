          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2019
      },
      {
        "id": "URY-cost_sharing-005",
        "statement": "In 2024 the moderating fees on the antidepressants fluoxetine and sertraline were eliminated, though the professional stamp fee is still charged.",
        "valence": "strength",
