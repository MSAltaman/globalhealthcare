          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-covered-004",
        "statement": "By the end of 2024 the number of people not fully covered because of unpaid contributions had fallen to 10,381 (about 0.5% of those eligible), down from 17,876 a year earlier.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.1 Population coverage",
          "page": 28,
          "char_start": 46152,
          "char_end": 46526,
