  "model": {
    "type": "social_health_insurance",
    "label": "Single national health insurance fund (FONASA) paying public and private not-for-profit providers by risk-adjusted capitation, with a state provider (ASSE) for people outside it"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
