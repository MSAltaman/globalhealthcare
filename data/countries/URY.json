    "access": [
      {
        "id": "URY-access-001",
        "statement": "Regulated mobility lets National Health Insurance beneficiaries change provider once they have at least two years with their current integral provider, or in the calendar year after being assigned to ASSE by default.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
