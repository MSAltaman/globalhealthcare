    "what_works": [
      {
        "id": "CYP-what_works-001",
        "statement": "Research in April 2024 reported that 92% of participants saw better service quality since GeSY began; the benefits they named most were lower access costs (62%), more choice of provider (32%), better quality (21%) and shorter waits (19%).",
