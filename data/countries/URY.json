    "reforms": [
      {
        "id": "URY-reforms-001",
        "statement": "Until 2007 most care was organised in two detached systems: the state provider ASSE, funded from general revenue for the poor and informal workers, and non-profit mutual providers (IAMCs) with fragmented occupation-based schemes for formal workers and the middle classes.",
        "valence": "neutral",
        "source_id": "equity-seg-2020",
