    "cost_sharing": [
      {
        "id": "URY-cost_sharing-001",
        "statement": "The ministry's out-of-pocket measure includes moderating fees and copayments such as tickets and orders, as well as direct household payments in commercial pharmacies, private clinics, glasses and psychology consultations, among others.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 6,
          "char_start": 6056,
          "char_end": 6300,
          "passage_sha256": "613188e62c841cc62a1aa4b7657c32857220f110ad4290a0b9477778428d0828"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-cost_sharing-002",
        "statement": "Out-of-pocket spending was 16.46% of total health spending in 2023 and fell by more than one percentage point to 15.65% in 2024.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 6,
          "char_start": 6583,
          "char_end": 6677,
          "passage_sha256": "4d529654b9fffd2bd6044f3fe43286f5d7f7d7fac63bae6f8f7dee0a6d5a1e19"
