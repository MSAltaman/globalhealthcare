    "access": [
      {
        "id": "HRV-access-001",
        "statement": "In 2024, 2.0% of people with medical needs reported unmet need for a medical examination because of cost, waiting time or distance (EU average 3.6%); among people at risk of poverty the figure was 4.8% (EU 6.0%).",
        "valence": "strength",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 5.2",
          "page": 13,
          "char_start": 79354,
          "char_end": 79704,
          "passage_sha256": "15b9842a45f46038c246f59244451214b8afa7b2acde9187f9b8315f582d9334"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-access-002",
        "statement": "Unmet medical need due to cost fell from 2.2% in 2011 to 0.2% in 2023.",
        "valence": "strength",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Accessibility and financial protection",
          "page": 14,
          "char_start": 31073,
