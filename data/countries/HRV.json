{
  "iso3": "HRV",
  "name": "Croatia",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "social_health_insurance",
    "label": "Single national health insurance fund financed mainly by payroll contributions and state-budget transfers, with voluntary insurance for co-payments"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "HRV-overview-002",
      "HRV-overview-001"
    ],
    "meets_definition": true
  },
  "sections": {
    "overview": [
      {
        "id": "HRV-overview-001",
        "statement": "Croatia's mandatory social health insurance covers an estimated 99% of the population as of 2021. The Croatian Health Insurance Fund is the only statutory insurer and the main purchaser of health services.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 4, first paragraph",
          "page": 8,
          "char_start": 45647,
          "char_end": 45889,
          "passage_sha256": "58f6baa903c46d122cdd6edb6df3bb1ed4534c9de499b1f84546e73b2bdccfca"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2021
      },
      {
        "id": "HRV-overview-002",
        "statement": "Health insurance is mandatory for all residents, including foreign nationals who live in the country for more than three months, and residents cannot opt out.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Coverage",
          "page": 7,
          "char_start": 11070,
          "char_end": 11290,
          "passage_sha256": "559b5c1fae331661aa6c3112efbc62ed4273b3f1e4ca6cf951cf8583a82dfcce"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-overview-003",
        "statement": "The Ministry of Health leads health system governance and tertiary care, while counties organise regional services and primary care; ownership of general hospitals moved from the counties to central government in January 2024.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Organization",
          "page": 3,
          "char_start": 2616,
          "char_end": 3399,
          "passage_sha256": "a8598ecaad0bf0c31100ef50143445c4495e1e3fc69f6f7aeee15d62221d8343"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-overview-004",
        "statement": "Secondary and tertiary providers are mostly publicly owned. Most primary care practices are now privately owned, but most of them are contracted by the insurance fund and depend on it for most of their income.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Providers",
          "page": 4,
          "char_start": 5296,
          "char_end": 5677,
          "passage_sha256": "c1a0a80481194bd68dcc019bc8e9b03b9f4da1dba276575b5bd33cbda4f3b8d7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-overview-005",
        "statement": "Every insured adult must register with a freely chosen family physician, who acts as gatekeeper to specialist and hospital care.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Primary and ambulatory care",
          "page": 11,
          "char_start": 21672,
          "char_end": 21986,
          "passage_sha256": "7f59f2a648ffca92e0c95bc93d364f6b1820564a059602c13797577fb88de9af"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "financing": [
      {
        "id": "HRV-financing-001",
        "statement": "In 2023 mandatory insurance contributions made up 78.0% of the insurance fund's revenue and the state budget supplied 13.9%.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Funding mechanisms",
          "page": 4,
          "char_start": 6250,
          "char_end": 6413,
          "passage_sha256": "dff1aa3cfeb415b97ab16f60039d53ab669db6cce2c88ab93e2e4b9d9c5c15f3"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "HRV-financing-002",
        "statement": "As of the 2024 summary, the contribution rate is 16.5% of gross salary for employees, transferred by the employer. Farmers and religious officials pay 7.5% of a share of the average salary, and pensioners pay 3% of pension income above the average net wage.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Funding mechanisms",
          "page": 4,
          "char_start": 6704,
          "char_end": 6981,
          "passage_sha256": "e18d293de0f5fe7e8e0d694f2e192c2d8d51b07b625dd810bf1ce95e387351e0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-financing-003",
        "statement": "Contributions for economically inactive groups such as pensioners and unemployed people are covered by transfers from the state budget, and dependents are covered through contributions paid by working family members.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 4",
          "page": 8,
          "char_start": 46257,
          "char_end": 46627,
          "passage_sha256": "339f2358da35425ca34a374270a18d013efbad74cb274e3374df38069fc38d61"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2021
      },
      {
        "id": "HRV-financing-004",
        "statement": "In 2023 public sources funded 84.9% of current health spending (EU average 80.3%), out-of-pocket payments 9.4% (EU 15.5%) and voluntary health insurance 5.7% (EU 4.5%).",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 4, health expenditure",
          "page": 9,
          "char_start": 50116,
          "char_end": 50418,
          "passage_sha256": "abae4c708f73c7066c303ed244a41703ba0d64b5b9f23d13bebe847fa63b6fba"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "HRV-financing-005",
        "statement": "Croatia has two kinds of voluntary health insurance: complementary (called supplementary in Croatia), which covers user charges in the mandatory scheme, and a second kind (called additional insurance) that covers a higher standard of care.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Health expenditure, footnote 1",
          "page": 6,
          "char_start": 8795,
          "char_end": 9118,
          "passage_sha256": "5ae20562a731204d2d2c2b4546fe7ced46946b9b5e296968bb45fe08012687a3"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "covered": [
      {
        "id": "HRV-covered-001",
        "statement": "Services for children and pregnant women, preventive services for people over 65 and people with disabilities, treatment of chronic psychiatric disease and cancer, immunisations, home nursing and palliative care are exempt from co-payments and fully covered by the insurance fund.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Coverage",
          "page": 7,
          "char_start": 11981,
          "char_end": 12349,
          "passage_sha256": "d192cf64a4fe2eea1c29d9db0abb1ecf65e8daeb2fc65a4e7684e6d53391682e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-covered-002",
        "statement": "Croatia uses a negative list to exclude services such as cosmetic surgery and a positive list of medicines; medicines not on the positive list must be paid for in full by patients.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 5.2",
          "page": 14,
          "char_start": 86599,
          "char_end": 86804,
          "passage_sha256": "68aba96949a9ab3ae3c271caaf15d0351c4cf7589b4af44f9b9cd5f5e6843aec"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-covered-003",
        "statement": "Almost all basic dental procedures, and emergency dental care, are covered by mandatory insurance, including orthodontics up to age 18 for specified cases.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Dental care",
          "page": 13,
          "char_start": 27190,
          "char_end": 27448,
          "passage_sha256": "9bf279681503d2d016765a84ffe2dd9089556cf7bdbd98006603a919a6e95372"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-covered-004",
        "statement": "Since 2010 a list of especially expensive medicines, such as cancer and rare-disease treatments, has been in place; they are given in hospital after approval by that hospital's medicines commission, and the insurance fund checks the use against its guidelines.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 6",
          "page": 21,
          "char_start": 138832,
          "char_end": 139268,
          "passage_sha256": "828f3db32ea36ffeac395d4ed9fe75917a9ad21caaa01aefd2122aab707ebf83"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "HRV-covered-005",
        "statement": "In 2023 social health insurance paid for 74% of retail pharmaceutical spending, voluntary insurance 2% and patients 24%.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 6",
          "page": 20,
          "char_start": 127828,
          "char_end": 127984,
          "passage_sha256": "a21fd2785ea974d709afae8e3cde34c9ba847367a8fd99227e1ba87ff9f00ac6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "HRV-covered-006",
        "statement": "The insurance fund, working with medical associations, sets the price list for all covered services, with the approval of the Ministry of Health.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Coverage",
          "page": 7,
          "char_start": 11697,
          "char_end": 11980,
          "passage_sha256": "b71fa47b86b01d609d57374e3a497010944c39b3e1a4fd736dacc09649967a38"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "cost_sharing": [
      {
        "id": "HRV-cost_sharing-001",
        "statement": "Patients pay user charges for hospital stays and primary care visits, with a ceiling of EUR 531 per illness episode in secondary and tertiary care. Medicines given in hospital carry no charge, and a primary care visit cost EUR 1.32 in 2024.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 5.2",
          "page": 14,
          "char_start": 86805,
          "char_end": 87033,
          "passage_sha256": "76767121a32c83983cc9ece51920038c1330e7604565b9948e01dc4697e5f490"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-cost_sharing-002",
        "statement": "About 20% of the population, including children, students, low-income groups and people with certain conditions, is exempt from user charges.",
        "valence": "neutral",
        "source_id": "chp-hrv-2025",
        "locator": {
          "section": "Section 5.2",
          "page": 14,
          "char_start": 87034,
          "char_end": 87179,
          "passage_sha256": "7946362b7e4d7b5b127b42ab49d73872b55984325a25160de889cb3f79956706"
