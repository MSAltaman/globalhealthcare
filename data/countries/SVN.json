          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2024
      },
      {
        "id": "SVN-covered-005",
        "statement": "Undocumented migrants are not eligible for coverage by the Health Insurance Institute, and adult asylum seekers can obtain most publicly financed care only after approval from the Asylum Centre Commission.",
        "valence": "weakness",
        "source_id": "who-afford-svn-2025",
        "locator": {
