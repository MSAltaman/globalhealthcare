          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "financial_hardship": [],
    "additional_care": [
      {
        "id": "HRV-additional_care-001",
        "statement": "Formal long-term care is still underdeveloped, so the burden falls mostly on family members.",
        "valence": "weakness",
        "source_id": "hss-hrv-2024",
        "locator": {
