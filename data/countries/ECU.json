        },
        "data_year": "2006-2014",
        "historical": true
      },
      {
        "id": "ECU-financial_hardship-003",
        "statement": "The same study reported that inequality in catastrophic spending increased within regions and for uninsured households between the 2006 and 2014 surveys.",
        "valence": "weakness",
        "source_id": "pmc-12314978",
        "locator": {
          "section": "Abstract",
          "char_start": 2725,
          "char_end": 3746,
          "passage_sha256": "37ee9df3a3d9b9d04c2584ca3d3d2e517ee3403e15ed8b2a4a6d372b7d5a5433"
