        "data_year": 2021
      },
      {
        "id": "LTU-financial_hardship-002",
        "statement": "The Observatory profile says heavy reliance on out-of-pocket payments leads to comparatively high financial hardship, and that 2025 efforts aim to curb extra charges by private providers for publicly funded services.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 22,
          "char_start": 154933,
          "char_end": 155267,
          "passage_sha256": "ef2b65511dc9b5c5da25408d5977e7506271b51eb45fc5d602afb146aec30239"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "additional_care": [
      {
        "id": "LTU-additional_care-001",
        "statement": "About half of outpatient medicine spending came from public sources in 2023, and out-of-pocket spending on medicines was EUR 237 per person, the fourth highest in the EU.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 3,
          "char_start": 7673,
          "char_end": 7855,
          "passage_sha256": "ee60b05662e88351d8aa6c9a0925b4cf2bba29301fdb52895d374f8e9545c1df"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LTU-additional_care-002",
        "statement": "Publicly financed specialist outpatient and inpatient care needs a referral, but these services can be reached directly by paying a fee.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 14,
          "char_start": 90879,
          "char_end": 91037,
          "passage_sha256": "0811bcef2d3f6c8b76a3c279056c61788400e9b0ea21b1339ebedbc5dc088b4d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "access": [
      {
        "id": "LTU-access-001",
        "statement": "In 2024, 5.6% of Lithuanians with a health need reported unmet needs for a medical examination (EU average 3.6%); unmet dental needs were 4.8% overall (EU 6.3%) and 12.1% among people at risk of poverty (EU 13.6%).",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 13,
          "char_start": 81393,
          "char_end": 82047,
          "passage_sha256": "b5b7f04761d000ce157272ab947f1419677d4ed913f465210351780c27fac688"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-access-002",
        "statement": "Waiting times for cataract surgery are among the shortest of 12 comparable EU countries, but waits for hip and knee replacement peaked at 195 and 390 days in 2023 and fell to 110 and 330 days in 2024, still well above pre-pandemic levels.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 15,
          "char_start": 101533,
          "char_end": 101861,
          "passage_sha256": "561e20e6e272d22f06e3f00002dab4f6e3b52d48cbdf486c0b5b44a6433c89d7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-access-003",
        "statement": "At the end of 2024, more than half of patients waiting for haematology, orthodontics, plastic surgery and some other specialist outpatient services waited over 30 days, as did 20-40% of those awaiting adult or paediatric oncology appointments.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 15,
          "char_start": 101875,
          "char_end": 102221,
          "passage_sha256": "bc0aceaf4eac308117ae329471605014a9425d6deb230ec6cdc8fc188006eac5"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-access-004",
        "statement": "In primary care, 90% of people could see their family doctor within a week, but 20-30% of children and adults seeking primary mental health consultations waited more than 15 days.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 15,
          "char_start": 102237,
          "char_end": 102462,
          "passage_sha256": "beebdbae74c2d91af9e25b997175e5e28f1ebaba4e7e7313217e01f6dbf20a10"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LTU-access-005",
        "statement": "In 2023 Lithuania had 4.6 physicians per 1,000 people, above the EU average of 4.3, but 7.5 practising nurses per 1,000, the lowest since 2010 and below the EU average of 8.5.",
        "valence": "neutral",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 9,
          "char_start": 51724,
          "char_end": 52170,
          "passage_sha256": "bfbbc9081d9df1308a37fe99bcc4887781896ed02d74d03d46682d226221a6a7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LTU-access-006",
        "statement": "Nurse density in municipal-level institutions differed ten-fold across municipalities in 2023.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 9,
          "char_start": 52657,
          "char_end": 52797,
          "passage_sha256": "5249ba4984a3ee6fb8e6f51a9650b01d414a61dba292efb5a42f44bcde598e93"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LTU-access-007",
        "statement": "Hospital beds fell to 5.5 per 1,000 people in 2023 (EU average 5.1) and hospitalisations stayed above the EU average, yet elective orthopaedic waits rose sharply in 2021-23, suggesting staff rather than bed capacity is the main constraint.",
        "valence": "weakness",
        "source_id": "chp-ltu-2025",
        "locator": {
          "page": 16,
          "char_start": 109377,
          "char_end": 109989,
          "passage_sha256": "2f4c5d06bf5a3104519547b3917e45d5206a4994f513aeaa9c10ae8c6f61028a"
