    "problems": [
      {
        "id": "URY-problems-001",
        "statement": "A 2020 study found the population remained segmented by ability to contribute to social security, because people without FONASA coverage can be covered only at ASSE through subsidy.",
        "valence": "weakness",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 32901,
          "char_end": 33082,
