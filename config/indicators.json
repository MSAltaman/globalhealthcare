{
  "description": "Indicators pulled by scripts/fetch_indicators.py from the World Bank, WHO Global Health Observatory and OECD APIs. Values come straight from the API; no model ever writes a number. The script records the original source organization for each.",
  "world_bank": [
    {
      "id": "SP.POP.TOTL",
      "label": "Population",
      "unit": "people",
      "group": "context"
    },
    {
      "id": "NY.GDP.PCAP.PP.CD",
      "label": "GDP per capita (PPP)",
      "unit": "current international $",
      "group": "context"
    },
    {
      "id": "SH.XPD.CHEX.GD.ZS",
      "label": "Health spending, % of GDP",
      "unit": "%",
      "group": "costs"
    },
    {
      "id": "SH.XPD.CHEX.PP.CD",
      "label": "Health spending per person (PPP)",
      "unit": "current international $",
      "group": "costs"
    },
    {
      "id": "SH.XPD.GHED.CH.ZS",
      "label": "Government share of health spending",
      "unit": "% of current health expenditure",
      "group": "costs"
    },
    {
      "id": "SH.XPD.OOPC.CH.ZS",
      "label": "Out-of-pocket share of health spending",
      "unit": "% of current health expenditure",
      "group": "costs"
    },
    {
      "id": "SP.DYN.LE00.IN",
      "label": "Life expectancy at birth",
      "unit": "years",
      "group": "outcomes"
    },
    {
      "id": "SP.DYN.IMRT.IN",
      "label": "Infant mortality",
      "unit": "per 1,000 live births",
      "group": "outcomes"
    },
    {
      "id": "SH.STA.MMRT",
      "label": "Maternal mortality",
      "unit": "per 100,000 live births",
      "group": "outcomes"
    },
    {
      "id": "SH.MED.PHYS.ZS",
      "label": "Physicians",
      "unit": "per 1,000 people",
      "group": "access"
    },
    {
      "id": "SH.MED.BEDS.ZS",
      "label": "Hospital beds",
      "unit": "per 1,000 people",
      "group": "access"
    }
  ],
  "lookback_years": 12,
  "who_gho": [
    {
      "id": "UHC_INDEX_REPORTED",
      "label": "UHC service coverage index",
      "unit": "index 0-100",
      "group": "coverage"
    },
    {
      "id": "FINPROTECTION_CATA_TOT_10_POP",
      "label": "Households spending over 10% of budget on health",
      "unit": "% of population",
      "group": "hardship"
    },
    {
      "id": "FINPROTECTION_CATA_TOT_25_POP",
      "label": "Households spending over 25% of budget on health",
      "unit": "% of population",
      "group": "hardship"
    },
    {
      "id": "FINPROTECTION_IMP_NPRELPL_POP",
      "label": "People pushed into poverty by health costs (relative poverty line)",
      "unit": "% of population",
      "group": "hardship"
    }
  ],
  "oecd": [
    {
      "id": "OECD_COVERAGE",
      "label": "Population covered for core services (public or primary private insurance)",
      "unit": "% of population",
      "group": "coverage",
      "dataflow": "OECD.ELS.HD,DSD_HEALTH_PROT@DF_HEALTH_PROT,1.1",
      "filters": {
        "Unit of measure": "Percentage of population",
        "Insurance type": "Public and primary voluntary health insurance"
      }
    },
    {
      "id": "OECD_TREATABLE_MORT",
      "label": "Treatable mortality (deaths healthcare should prevent), age-standardised",
      "unit": "deaths per 100,000",
      "group": "outcomes",
      "dataflow": "OECD.ELS.HD,DSD_HEALTH_STAT@DF_AM,1.1",
      "filters": {
        "Measure": "Treatable mortality",
        "Unit of measure": "Deaths per 100 000 inhabitants",
        "Sex": "Total",
        "Calculation methodology": "Standardised rate"
      }
    }
  ],
  "oecd_financing": {
    "dataflow": "OECD.ELS.HD,DSD_SHA@DF_SHA_FS,1.1",
    "label": "Where health money comes from: revenues of all financing schemes, % of GDP",
    "filters": {
      "FINANCING_SCHEME": "_T",
      "UNIT_MEASURE": "PT_B1GQ"
    },
    "note": "OECD System of Health Accounts (SHA 2011) revenue classification. Segments sum to current health spending as % of GDP. 'General taxes' (FS.1) includes government transfers to social insurance funds. OECD counts US employer insurance as compulsory prepayment since the ACA mandate.",
    "segments": [
      {
        "id": "taxes",
        "label": "General taxes (government budget)",
        "codes": [
          "FS1"
        ]
      },
      {
        "id": "payroll_employer",
        "label": "Social insurance: employer contributions",
        "codes": [
          "FS32"
        ]
      },
      {
        "id": "payroll_worker",
        "label": "Social insurance: employee and self-employed contributions",
        "codes": [
          "FS31",
          "FS33"
        ]
      },
      {
        "id": "payroll_other",
        "label": "Social insurance: other contributions",
        "codes": [
          "FS34"
        ],
        "residual_of": "FS3"
      },
      {
        "id": "mandated_employer",
        "label": "Mandatory private premiums: employers",
        "codes": [
          "FS42"
        ]
      },
      {
        "id": "mandated_individual",
        "label": "Mandatory private premiums: individuals",
        "codes": [
          "FS41",
          "FS43"
        ],
        "residual_of": "FS4"
      },
      {
        "id": "voluntary",
        "label": "Voluntary insurance premiums",
        "codes": [
          "FS5"
        ]
      },
      {
        "id": "households",
        "label": "Paid directly by households (out of pocket)",
        "codes": [
          "FS61"
        ]
      },
      {
        "id": "private_unsplit",
        "label": "Households and other private payments (not broken down by OECD)",
        "codes": [],
        "unsplit_of": "FS6"
      },
      {
        "id": "other",
        "label": "Other (charities, companies, foreign aid)",
        "codes": [
          "FS62",
          "FS63",
          "FS2",
          "FS7"
        ],
        "residual_of": "FS6+FS2+FS7"
      }
    ]
  },
  "derived": [
    {
      "id": "GOV_HEALTH_PC",
      "label": "Government health spending per person (PPP)",
      "unit": "current international $",
      "group": "costs",
      "formula": "SH.XPD.CHEX.PP.CD * SH.XPD.GHED.CH.ZS / 100"
    },
    {
      "id": "GOV_HEALTH_GDP",
      "label": "Government health spending, % of GDP",
      "unit": "% of GDP",
      "group": "costs",
      "formula": "SH.XPD.CHEX.GD.ZS * SH.XPD.GHED.CH.ZS / 100"
    }
  ]
}
