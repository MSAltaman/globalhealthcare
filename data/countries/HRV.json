        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "HRV-cost_sharing-003",
        "statement": "Complementary voluntary insurance plans cover all patient co-payments in the mandatory scheme.",
        "valence": "neutral",
        "source_id": "hss-hrv-2024",
        "locator": {
          "section": "Health expenditure",
