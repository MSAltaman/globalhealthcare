          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      }
    ],
    "outcomes": [
      {
        "id": "URY-outcomes-001",
        "statement": "Life expectancy at birth in Uruguay was 78.3 years in 2024, 3.6 years higher than in 2000 (74.7) and above the average for the Region of the Americas.",
        "valence": "neutral",
        "source_id": "hia-ury",
        "locator": {
          "section": "see page",
