    "access": [
      {
        "id": "URY-access-001",
        "statement": "Regulated mobility lets National Health Insurance beneficiaries change provider once they have at least two years with their current integral provider, or in the calendar year after being assigned to ASSE by default.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 12,
          "char_start": 24944,
          "char_end": 25279,
          "passage_sha256": "94f2dc80b8145567393af38f43c55b764db1089896afaff0e123f9c48710a393"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-access-002",
        "statement": "A 2023 decree added an exception to the two-year rule: users can request a change of provider when they asked for the first available specialist appointment, or when the legal deadline for coordinating surgery was exceeded.",
        "valence": "strength",
        "source_id": "junasa-2024",
        "locator": {
          "section": "see page",
          "page": 13,
          "char_start": 26772,
          "char_end": 27348,
          "passage_sha256": "76b2400de70402f4e1d3191958b86fde8d0bbe70b3feee86efbdb578fb9d8a0a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-access-003",
        "statement": "A 2020 study noted that mutual providers (IAMCs), the main service providers, are open only to FONASA contributors or holders of voluntary insurance, which may hamper accessibility and timely attention for everyone else, who use a more restricted network.",
        "valence": "weakness",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 35191,
          "char_end": 35499,
          "passage_sha256": "eafaff31f61ff4c1d6e18e3efbd08d90a0cc6c50661d01f4c072d8402cfbf02c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2019
      },
      {
        "id": "URY-access-004",
        "statement": "From January 2024 the care goal on timely cervical cancer treatment required treatment to start within 65 days of the Pap or HPV test; providers averaged 88% compliance in the latest four-month period reported.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
