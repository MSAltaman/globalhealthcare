    ],
    "cost_sharing": [
      {
        "id": "ECU-cost_sharing-001",
        "statement": "The constitution requires public state health services to be universal and free of charge at all levels of care, including diagnosis, treatment, medicines and rehabilitation.",
        "valence": "strength",
        "source_id": "const-ecu",
        "locator": {
          "section": "Article 362",
          "char_start": 289704,
          "char_end": 289886,
          "passage_sha256": "2776bb049b5ea6f2ae03e48ec10d0ed638967bf5fb1a73afb77e934444def912"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-cost_sharing-002",
        "statement": "Official health accounts put household out-of-pocket health spending at 33.4% in 2024, 0.3 percentage points more than in 2023.",
        "valence": "weakness",
        "source_id": "inec-css-2024",
        "locator": {
          "section": "Resumen de resultados",
          "page": 3,
          "char_start": 2935,
          "char_end": 3062,
          "passage_sha256": "482627d354292ef7d4b8c0a314aaadd2a98853e6609546609d2718d80d8af798"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2024
      },
      {
        "id": "ECU-cost_sharing-003",
        "statement": "A 2026 paper notes that Ecuador's out-of-pocket spending indicator does not separate medicines and rests on 2012 and 2014 surveys, so its 2016-2023 values (30.6-33%) are pre-COVID-19 estimates rather than direct measurements.",
        "valence": "neutral",
        "source_id": "pmc-12925043",
        "locator": {
          "section": "Introduction",
          "char_start": 4618,
          "char_end": 5172,
          "passage_sha256": "e69a1aaeabc163dc5684d20154dddef502d45d35ae40cd255270dd0fb2f6bec2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": "2016-2023"
      }
    ],
    "financial_hardship": [
      {
        "id": "ECU-financial_hardship-001",
        "statement": "Between the 2006 and 2014 national living-standards surveys, the share of households with any out-of-pocket health spending fell by 14 percentage points.",
        "valence": "strength",
        "source_id": "pmc-12314978",
        "locator": {
          "section": "Abstract",
          "char_start": 2725,
          "char_end": 3250,
