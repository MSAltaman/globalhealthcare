{
  "iso3": "LVA",
  "name": "Latvia",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "national_health_service",
    "label": "Tax-funded national health service buying from public and private providers, with a state-paid minimum, a broader insurance-based package and heavy out-of-pocket spending"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "LVA-overview-003",
      "LVA-overview-005"
    ],
    "meets_definition": true
  },
  "sections": {
    "overview": [
      {
        "id": "LVA-overview-001",
        "statement": "Latvia pays for health care mainly from general taxation plus social security contributions. A single purchaser, the National Health Service, contracts with both public and private providers.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 8,
          "char_start": 47040,
          "char_end": 47251,
          "passage_sha256": "13b163dbdb89891c89bf5f93f38d0f07d3de31256f361f5232ccb925b6cc49c5"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-overview-002",
        "statement": "Most primary care is delivered by private providers under contract to the National Health Service. Secondary care is split roughly evenly between public and private clinics, while the most specialised hospital care is mostly public.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 8,
          "char_start": 47449,
          "char_end": 47852,
          "passage_sha256": "813ef08e547cdf87b3f31382585c510a049f3e6d0ea5f7032350f2307e84ebe2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-overview-003",
        "statement": "The 2025 country profile reports that the statutory system formally includes 100% of the population.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 8,
          "char_start": 47938,
          "char_end": 48053,
          "passage_sha256": "b333bd48123b5f00f88b51f8d7cc6a10395d7e43ffbaf72ed8b81b94921c6d5b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-overview-004",
        "statement": "In 2024 Latvia had about 1.87 million residents, 21% of them over 65 (EU: 22%). GDP per capita was EUR 28,031 in purchasing-power terms, against EUR 39,675 for the EU.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "Demographic and socioeconomic context",
          "page": 2,
          "char_start": 1105,
          "char_end": 1281,
          "passage_sha256": "ba7e29826e617eba94c5941476235c8021fb0330410b7b2f07ad46e5ffcc563c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-overview-005",
        "statement": "Latvia's Constitution commits the state to guarantee a basic level of medical assistance to everyone, and the Medical Treatment Law gives everyone a right to emergency medical care.",
        "valence": "neutral",
        "source_id": "hit-lva-2019",
        "locator": {
          "section": "3.3.1 Coverage",
          "page": 79,
          "char_start": 144904,
          "char_end": 145279,
          "passage_sha256": "98fbeaafcccb28dabc7988e495f0e1826af3aeb1f8831db3981d7490fc6a052d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2019
      }
    ],
    "financing": [
      {
        "id": "LVA-financing-001",
        "statement": "For an employee insured against all social risks, the mandatory state social insurance contribution rate is 34.09%: employers pay 23.59% and employees 10.50%. One percentage point of the total is allocated to funding health services.",
        "valence": "neutral",
        "source_id": "vsaa-contrib",
        "locator": {
          "section": "On contributions",
          "char_start": 417,
          "char_end": 670,
          "passage_sha256": "851d98cf4790626d981af2a833e1332ec2c1b26bc42a637df95c8ffd3ad6d947"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LVA-financing-002",
        "statement": "In 2026 the social insurance contribution base is capped at EUR 105,300 a year. Income above the cap is still charged contributions, but these go to the solidarity tax, which the State Revenue Service administers.",
        "valence": "neutral",
        "source_id": "vsaa-contrib",
        "locator": {
          "section": "On contributions: object of mandatory contributions",
          "char_start": 3105,
          "char_end": 3457,
          "passage_sha256": "4a2977b37449056102151c546c8ab12c309563799330613501ce775b2c77c274"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LVA-financing-003",
        "statement": "The law text sets the annual health insurance contribution for people who are not otherwise socially insured at five percent of twelve times the national minimum monthly wage, payable into the state budget.",
        "valence": "neutral",
        "source_id": "hcfl-lva",
        "locator": {
          "section": "Section 12",
          "char_start": 20533,
          "char_end": 20686,
          "passage_sha256": "2bd97eda43254f79ec8edaa37ce8fcffe422c4c8e0861e5f7fc8a30dc6edb21b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-financing-004",
        "statement": "Public funding paid for 59% of health spending in 2023, well below the EU average of 80%.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 8,
          "char_start": 49131,
          "char_end": 49241,
          "passage_sha256": "9d7eebd8fb9f0f76b1dd2a4f2c45d4d63d1d2a78dcf77e97f65d81d70e1fc019"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-financing-005",
        "statement": "Voluntary health insurance, bought by higher earners and by employers offering fuller cover for quicker access to private services, paid for 5% of health spending in 2023.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 9,
          "char_start": 49868,
          "char_end": 50112,
          "passage_sha256": "3ea0529cc8ddd35e76b585cc311e5f860f4f05f28ce447960d510a84a7b0bc38"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-financing-006",
        "statement": "The Health Care Financing Law (English consolidated text current to December 2022; later amendments are not reflected) lists these revenue sources: state budget general revenue, a state budget share drawn from one percentage point of social insurance contributions, state-budgeted health insurance contributions, patient co-payments, EU funds, municipal budgets and the own revenue of public medical institutions.",
        "valence": "neutral",
        "source_id": "hcfl-lva",
        "locator": {
          "section": "Section 4",
          "char_start": 3647,
          "char_end": 4949,
          "passage_sha256": "2d3b6790666d449e3be87c87dac394aac48945a4a2f17e0d5c95cf0be0915848"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-financing-007",
        "statement": "A 2019 review reported that about 60% of health system revenue came from general, non-earmarked central taxation, collected by the national revenue service.",
        "valence": "neutral",
        "source_id": "hit-lva-2019",
        "locator": {
          "section": "3.2 Sources of revenue and financial flows",
          "page": 77,
          "char_start": 141482,
          "char_end": 141617,
          "passage_sha256": "7b4b79a12fb49e8bfff48aba1e7d92c02b51ff2f9e70b755f10fd2fe3a271837"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2017
      },
      {
        "id": "LVA-financing-008",
        "statement": "As of the 2019 review, all health care services were exempt from VAT, and residents could reclaim part of their income tax by declaring private medical payments, up to EUR 600 per household member and no more than half of taxable income. The review does not state what these subsidies cost.",
        "valence": "neutral",
        "source_id": "hit-lva-2019",
        "locator": {
          "section": "3.2 Sources of revenue and financial flows",
          "page": 77,
          "char_start": 142384,
          "char_end": 142773,
          "passage_sha256": "d489a0d0d681ff41d37f3ac542241295d93ac565f50b2f2f45aaa733566adc6e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2019
      },
      {
        "id": "LVA-financing-009",
        "statement": "As of the 2019 review, voluntary health insurance premiums that employers paid for staff were treated as production costs and exempt from corporate, personal income and social contribution taxes, subject to a ceiling per employee of 10% of annual salary and EUR 426.86.",
        "valence": "neutral",
        "source_id": "hit-lva-2019",
        "locator": {
          "section": "3.5 Voluntary health insurance",
          "page": 91,
          "char_start": 172926,
          "char_end": 173221,
          "passage_sha256": "2d4b30d330d914d1120b36426317b8f0904da8dab704012c4e671dda4d62b10a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2019
      }
    ],
    "covered": [
      {
        "id": "LVA-covered-001",
        "statement": "In the English text of the Health Care Financing Law current to 2022, the state-paid medical assistance minimum covers emergency care, childbirth, general practitioner care and services for diseases that matter most for public health, such as mental illness and tuberculosis.",
        "valence": "neutral",
        "source_id": "hcfl-lva",
        "locator": {
          "section": "Section 8",
          "char_start": 11116,
          "char_end": 12143,
          "passage_sha256": "14766f0bc26d7d18ffd35717a1b929a2b681d110dd9ed0fd7de5d033a1df033b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-covered-002",
        "statement": "Under the same law text, people who are socially insured, or who are not but pay the health insurance contribution (for residents in the listed status groups), are entitled to the broader mandatory health insurance package.",
        "valence": "neutral",
        "source_id": "hcfl-lva",
        "locator": {
          "section": "Section 11",
          "char_start": 14847,
          "char_end": 15358,
          "passage_sha256": "fdd015f58b9ec8466eafadf0e3b68bd55f35ab16bd5d62ca4269c7bef67b3dd1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-covered-003",
        "statement": "The scope of publicly funded services is limited, notably for adult dental care, physiotherapy and some outpatient medicines.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 8,
          "char_start": 48054,
          "char_end": 48196,
          "passage_sha256": "f687c4bbc3becbe736abf7ad015198f9fd70894f6c474128b964f789a2f38d36"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-covered-004",
        "statement": "Under the Health Care Financing Law text current to 2022, the Cabinet of Ministers decides which services belong to the mandatory insurance package, how they are organised and paid, the fee amounts and how queues for care are formed.",
        "valence": "neutral",
        "source_id": "hcfl-lva",
        "locator": {
          "section": "Section 10",
          "char_start": 14335,
          "char_end": 14731,
          "passage_sha256": "aede4dd1aeb9209dfaf074259d835551d22cb27e35b6045958dd9ef99cf7cb54"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-covered-005",
        "statement": "A 2025 legal survey describes the National Health Service as financed from fixed state budget funds: hospitals get a set sum from the overall budget and plan state-paid services around it.",
        "valence": "neutral",
        "source_id": "ibanet-lva",
        "locator": {
          "section": "Question 5",
          "page": 2,
          "char_start": 4204,
          "char_end": 4609,
          "passage_sha256": "e2fb77b44a3c80c3ab050f52ae3382fd328ac55e4360a8219b0eb4a1db5b84ef"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "cost_sharing": [
      {
        "id": "LVA-cost_sharing-001",
        "statement": "Patients pay co-payments even for essential care such as GP and specialist visits, hospital stays and prescribed medicines. Annual caps and per-admission limits exist and some groups are exempt, but cost-sharing remains a barrier for lower-income households.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 14,
          "char_start": 85162,
          "char_end": 85614,
          "passage_sha256": "1fabf430b4296c7fdfde943cfe7802f300ba31e5227d8d6ace612cd42323979c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-cost_sharing-002",
        "statement": "The poorest households have been exempt from all user charges for medical services since 2009. Children under 18, pregnant women and people with severe disabilities are also exempt.",
        "valence": "strength",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 15,
          "char_start": 98574,
          "char_end": 98781,
          "passage_sha256": "27d986c9a5939d0a43652d0f079b828f9e2072f92a7d1159c4bccb7bf7fa26db"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-cost_sharing-003",
        "statement": "Outpatient prescriptions carry a fixed charge of EUR 0.75 plus a co-payment of 0% or 25% of the reference price. The cap on co-payments for medical care does not cover outpatient prescribed medicines and is not linked to income.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "6 Spotlight on pharmaceuticals",
          "page": 20,
          "char_start": 132523,
          "char_end": 132933,
          "passage_sha256": "ad92262193f8bace19180dfbace3f67de7de964891d97a9a52ac7226e1076b41"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LVA-cost_sharing-004",
        "statement": "A 2025 legal survey lists the state-paid co-payment for a general practitioner visit as EUR 2 for people under 65 and EUR 1 for those over 65, and EUR 4 for a specialist consultation.",
        "valence": "neutral",
        "source_id": "ibanet-lva",
        "locator": {
          "section": "Question 8",
          "page": 3,
          "char_start": 7037,
          "char_end": 7226,
          "passage_sha256": "6b459e93111711ae59d3ce736558da035d291927b012fc1c1eb3808a92aa3b47"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "financial_hardship": [
      {
        "id": "LVA-financial_hardship-001",
        "statement": "In a national survey run from October 2025 to January 2026 (2,460 respondents aged 15 and over), 14.3% said they had borrowed money to pay for health care.",
        "valence": "weakness",
        "source_id": "pv-13697582",
        "locator": {
          "section": "Abstract: Results",
          "char_start": 3493,
          "char_end": 3575,
          "passage_sha256": "34db0a01d09356b188837d4cdd6969085ce116d393217cf0686acca7c39b4cf0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LVA-financial_hardship-002",
        "statement": "In the same People's Voice survey, 26.8% of respondents felt somewhat or very confident they could afford care if they became very sick.",
        "valence": "weakness",
        "source_id": "pv-13699942",
        "locator": {
          "section": "Abstract: Results",
          "char_start": 2429,
          "char_end": 2582,
          "passage_sha256": "49fd98b26d71c6f3e60c704c9c2d5034bc260af2f00d3920fe92f9850f0bdfe2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LVA-financial_hardship-003",
        "statement": "Among respondents at risk of poverty who needed care, 18.2% reported unmet medical needs in 2024, against an EU average of 6.0%.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 13,
          "char_start": 79874,
          "char_end": 80052,
          "passage_sha256": "ea5409001bc3d7d22d7801c2cad2afaea5da8faae49cfb359cd74540fba50df6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "additional_care": [
      {
        "id": "LVA-additional_care-001",
        "statement": "Unmet need for dental care among people who needed it reached 16.5% in 2024, against an EU average of 6.3%. The profile links this to limited public coverage of oral health and heavy reliance on out-of-pocket spending.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 13,
          "char_start": 79608,
          "char_end": 79873,
          "passage_sha256": "e0c2515fd9da7224edf291e2e6725b309180f4c248ce349e3f86629f041d6447"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-additional_care-002",
        "statement": "In 2023 long-term care took 7% of current health spending, and prevention and administration took 3% each.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "4 Health system",
          "page": 9,
          "char_start": 50728,
          "char_end": 50871,
          "passage_sha256": "0d2f77cb34a719105b625e0be03f90d7de43d19457bad65f14f55145c790a741"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "access": [
      {
        "id": "LVA-access-001",
        "statement": "In 2024, 10.7% of Latvians who reported needing care had unmet medical needs because of cost, distance or waiting time, about three times the EU average of 3.6%.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 13,
          "char_start": 79360,
          "char_end": 79594,
          "passage_sha256": "6de7400c9359033040785fd95288378656676c2a51bef0df72d3ae8dfe8001d9"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-002",
        "statement": "Providers work to annual public funding caps. Once a facility reaches its cap, patients wait for the next calendar year or pay themselves, which the profile says contributes to long waits, especially in paediatric care.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 15,
          "char_start": 96258,
          "char_end": 96742,
          "passage_sha256": "e65d2cd4b8e70328bf56c28e3da42aeb1a43fa743fae3b9dbffa16536414251e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "LVA-access-003",
        "statement": "In the survey fielded October 2025 to January 2026, 12.8% of respondents said they did not get needed care in the past year. Long waiting times were the most common reason (43%), followed by additional out-of-pocket payments (18.7%).",
        "valence": "weakness",
        "source_id": "pv-13697582",
        "locator": {
          "section": "Abstract: Results",
          "char_start": 3042,
          "char_end": 3318,
          "passage_sha256": "ec581c3a43f06a688260af55ef51612accb5b439834a0f47771af83576f8c71d"
        },
