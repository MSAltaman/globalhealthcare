{
  "iso3": "LVA",
  "name": "Latvia",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "national_health_service",
    "label": "Tax-funded national health service with a single purchaser (the National Health Service) contracting public and private providers; patient co-payments and high out-of-pocket spending"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "LVA-overview-001",
      "LVA-overview-002",
      "LVA-overview-003"
    ],
    "meets_definition": true
  },
  "sections": {
    "overview": [
      {
        "id": "LVA-overview-001",
        "statement": "Latvia's National Health Service covers a population of about 1.8 million and rests on universal coverage; statutory care is paid mainly from general taxation, with a smaller part from social security contributions.",
        "valence": "neutral",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 3,
          "char_start": 2519,
          "char_end": 2766,
          "passage_sha256": "8a64899f3c664d3c9d18dc35422cdff06e6dd0a9c34cfb4ff6507a85a0762197"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-overview-002",
        "statement": "All residents are formally included in the statutory system, but the package of covered services is narrow, notably for adult dental care, physiotherapy and some outpatient medicines.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 8,
          "char_start": 47938,
          "char_end": 48196,
          "passage_sha256": "543341648966f870188898657a2b58919cd67139459f048a4caca0a3498971c2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LVA-overview-003",
        "statement": "Entitlement follows residence, and the state pays for every service except those placed on an exclusion list (a negative list); care is delivered by state, municipal and private providers.",
        "valence": "neutral",
        "source_id": "vm-system",
        "locator": {
          "section": "Full text",
          "char_start": 135,
          "char_end": 307,
          "passage_sha256": "335bea45f12333ad041766ceec15dcf50a8d4d6a0a23d4a69557559fe9a22bf3"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      },
      {
        "id": "LVA-overview-004",
        "statement": "The National Health Service acts as the single purchaser and contracts both public and private providers; most primary care is private, secondary care is split about evenly between public and private clinics, and tertiary care is mostly public.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 8,
          "char_start": 47147,
          "char_end": 47852,
          "passage_sha256": "9c6493df8877a2c1431a54676d7c104a8d1530a6a3f9f95a1f96420f134258c6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "financing": [
      {
        "id": "LVA-financing-001",
        "statement": "Public sources paid for 59% of Latvian health spending in 2023, against an EU average of 80%.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 8,
          "char_start": 49131,
          "char_end": 49241,
          "passage_sha256": "9d7eebd8fb9f0f76b1dd2a4f2c45d4d63d1d2a78dcf77e97f65d81d70e1fc019"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-financing-002",
        "statement": "Households' out-of-pocket payments were 35% of health spending in 2023, among the highest shares in the EU, where the average was 16%.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 8,
          "char_start": 49344,
          "char_end": 49479,
          "passage_sha256": "5280785f52c96d9c40e5639d98793afec87ad9f919d5a49ebffed270b0aaccb0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-financing-003",
        "statement": "The State Social Insurance Agency gives the total mandatory social insurance contribution for an employee covered for all risks as 34.09% of pay (employer 23.59%, employee 10.5%), and states that 1 percentage point of that total goes to funding health care services.",
        "valence": "neutral",
        "source_id": "vsaa-contrib",
        "locator": {
          "section": "Full text",
          "char_start": 417,
          "char_end": 670,
          "passage_sha256": "851d98cf4790626d981af2a833e1332ec2c1b26bc42a637df95c8ffd3ad6d947"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "LVA-financing-004",
        "statement": "Parliament approves the health budget each year and sets its allocation by Ministry of Health priorities; about 85% goes to purchasing services through the National Health Service, and the rest funds emergency care, sector management and public health activities run by the Ministry.",
        "valence": "neutral",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 4,
          "char_start": 6216,
          "char_end": 6650,
          "passage_sha256": "24afdb44f94dcea52e22750fce2506af183c17706c884efd85b80ddc57854b2e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "covered": [
      {
        "id": "LVA-covered-001",
        "statement": "The Ministry of Health lists the state-funded package as including GP care and an annual preventive visit, specialist care, referred laboratory tests and procedures, day-hospital and home care, emergency services, hospital care, rehabilitation after acute treatment, and reimbursed medicines and devices, with patients paying co-payments.",
        "valence": "neutral",
        "source_id": "vm-system",
        "locator": {
          "section": "Full text",
          "char_start": 502,
          "char_end": 1392,
          "passage_sha256": "3e02475bf899d48ac2dfe7f73d4dba2c6a7997154593b62a0cf8aa74d03c3c31"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      },
      {
        "id": "LVA-covered-002",
        "statement": "The benefits package is limited in scope and leaves out adult dental care and most rehabilitation and physiotherapy; co-payments apply to several services and to reimbursed medicines.",
        "valence": "weakness",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 6,
          "char_start": 10102,
          "char_end": 10405,
          "passage_sha256": "8807e3f0096acc5a946e19e088f616afd5135059c00c4df30132fb844d37e633"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-covered-003",
        "statement": "State-funded dental care is free for people up to 18 and for orthodontic treatment of congenital conditions up to age 22; about 62% of dentists hold contracts with the National Health Service.",
        "valence": "neutral",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 12,
          "char_start": 24120,
          "char_end": 24422,
          "passage_sha256": "2e8c69f4b9e5ecd35361c42a9c4cffd1419103a105a26cbfe85ddf4fa5339ef1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-covered-004",
        "statement": "From late 2023 the state pays for home-based palliative care delivered by mobile teams available around the clock, aimed at patients expected to live up to six months.",
        "valence": "strength",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 12,
          "char_start": 23701,
          "char_end": 24046,
          "passage_sha256": "627e2b94b54023915d7c45c135416cc5ce8da56f02304f4d832c331fd07da440"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-covered-005",
        "statement": "Decisions on reimbursing medicines draw on economic evaluation and budget impact analysis, and the National Health Service decides reimbursement and prices.",
        "valence": "neutral",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 18,
          "char_start": 41540,
          "char_end": 41649,
          "passage_sha256": "255a317f166e84229f9bf9a7e8c52868b2f0027d910073cf9cc34d858c082db3"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "cost_sharing": [
      {
        "id": "LVA-cost_sharing-001",
        "statement": "For state-funded care the National Health Service lists a patient fee of EUR 2 for a family doctor visit (EUR 1 for people over 65) and EUR 4 for a specialist visit.",
        "valence": "neutral",
        "source_id": "vmnvd-copay",
        "locator": {
          "section": "Full text",
          "char_start": 501,
          "char_end": 700,
          "passage_sha256": "69f2b6e64f45b2f96b963d648bae2daad0a0388151b09cbde0339a2a8599169b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-cost_sharing-002",
        "statement": "Patient fees are capped at EUR 355 per hospital treatment case and EUR 570 per calendar year, with fees paid in all settings counting towards the annual cap.",
        "valence": "neutral",
        "source_id": "vmnvd-copay",
        "locator": {
          "section": "Full text",
          "char_start": 2374,
          "char_end": 2744,
          "passage_sha256": "01065af5f8fd31b04d4180febaddb131dd2e518d1f640992e5d4c9e3a9028677"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-cost_sharing-003",
        "statement": "Patient fees do not apply to children under 18, to pregnancy and post-natal care, to people in the first disability group, or to emergency ambulance care, and the list also covers recognised poor persons and preventive screening and vaccination.",
        "valence": "neutral",
        "source_id": "vmnvd-copay",
        "locator": {
          "section": "Full text",
          "char_start": 3378,
          "char_end": 3897,
          "passage_sha256": "20a46a51e222399bbfd16f414e4c5f6f3a83e1a47ed76fa6a9b1ab63c65bd8f0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "LVA-cost_sharing-004",
        "statement": "Medicines are the main driver of out-of-pocket spending: many are not reimbursed and outpatient medicines have no ceiling on what patients pay.",
        "valence": "weakness",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 6,
          "char_start": 9803,
          "char_end": 9961,
          "passage_sha256": "f60f8048e1b9482d1a5dc7b8c231cbb3e5e8fd406bd039230e03e8b2a9c0a369"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-cost_sharing-005",
        "statement": "Patients pay co-payments even for essential services such as GP and specialist visits, hospital stays and prescribed medicines; annual caps and per-stay limits exist, but cost-sharing still blocks access for lower-income households despite exemptions for some groups.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 14,
          "char_start": 85162,
          "char_end": 85614,
          "passage_sha256": "1fabf430b4296c7fdfde943cfe7802f300ba31e5227d8d6ace612cd42323979c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "financial_hardship": [],
    "additional_care": [
      {
        "id": "LVA-additional_care-001",
        "statement": "Because publicly financed benefits are limited, patients either pay privately or rely on supplementary voluntary health insurance.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 8,
          "char_start": 48197,
          "char_end": 48394,
          "passage_sha256": "72fa8791e0c369aabe223a5f18216c23b5f57e625b2631443380b64ab148986d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "LVA-additional_care-002",
        "statement": "Voluntary health insurance paid for 5% of health spending in 2023; higher earners and employers buy it mainly to get quicker access to private services.",
        "valence": "neutral",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 9,
          "char_start": 49868,
          "char_end": 50112,
          "passage_sha256": "3ea0529cc8ddd35e76b585cc311e5f860f4f05f28ce447960d510a84a7b0bc38"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "access": [
      {
        "id": "LVA-access-001",
        "statement": "In 2024, 10.7% of Latvians with a care need reported unmet medical needs due to cost, distance or waiting time (EU average 3.6%), and 16.5% reported unmet dental needs (EU average 6.3%).",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 13,
          "char_start": 79360,
          "char_end": 79767,
          "passage_sha256": "95e99393b915494d0967673303ef40141c880eb15e2731734a7dd20b66038520"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-002",
        "statement": "Among people at risk of poverty with care needs, 18.2% reported unmet medical needs (EU average 6.0%) and 36.3% unmet dental needs (EU average 13.6%) in 2024.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 13,
          "char_start": 79874,
          "char_end": 80168,
          "passage_sha256": "806a9f9f5d3dafbc4e2f5b67d6662b4387c83b46f0505c8eed01a1b5ecb6c3af"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-003",
        "statement": "Publicly funded services are subject to annual quotas; once a quota is used up, patients wait until the next year or pay for care themselves.",
        "valence": "weakness",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 14,
          "char_start": 30949,
          "char_end": 31191,
          "passage_sha256": "06d596965fc745317b45923ff984e7dd91f2a8a1d6e6e069bc8eb1059bbc12ec"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-004",
        "statement": "Almost everyone is registered with a GP who acts as gatekeeper to specialist and hospital care, with exceptions such as gynaecologists, and direct access has recently been widened to some specialists including ophthalmologists and psychiatrists.",
        "valence": "neutral",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 10,
          "char_start": 18785,
          "char_end": 19089,
          "passage_sha256": "4f3a70263646ff0b0ef2b88abb9098adb1afcb86544bf4b845a622e7ce78a4aa"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-005",
        "statement": "Services concentrate in cities: about 52% of GP practices are in the Greater Riga area, and access to primary and specialist care falls with distance from Riga.",
        "valence": "weakness",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 9,
          "char_start": 15675,
          "char_end": 16035,
          "passage_sha256": "d77a133b113ef827df5ab57a89c5420a02bf6afed89e82874981e2ec26e13de8"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-006",
        "statement": "Rural primary care is shrinking as many GPs near retirement and young doctors avoid remote areas with limited diagnostics.",
        "valence": "weakness",
        "source_id": "hss-lva-2024",
        "locator": {
          "page": 11,
          "char_start": 22376,
          "char_end": 22622,
          "passage_sha256": "24166bc6e32c753374d690376ca407d9cda90c17344e5bbc308777f6d745b999"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-access-007",
        "statement": "Latvia had 4.2 nurses per 1,000 people in 2023, half the EU average of 8.5.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 10,
          "char_start": 58624,
          "char_end": 58732,
          "passage_sha256": "158cfc13b71a9610eeec55b9e2c2e2c263f9845ce0631738745ece3b4fc2cc88"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      }
    ],
    "outcomes": [
      {
        "id": "LVA-outcomes-001",
        "statement": "Life expectancy at birth was 76.7 years in 2024, five years below the EU average, and women lived about ten years longer than men.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 3,
          "char_start": 4485,
          "char_end": 4665,
          "passage_sha256": "8bb806c26c86294f60b3cfe2106fc98a8caad562a7b19e8af3e000a30a75057b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "LVA-outcomes-002",
        "statement": "Latvia had the EU's highest avoidable mortality rate in 2022, over 540 deaths per 100,000, more than double the EU average of 258.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 11,
          "char_start": 64992,
          "char_end": 65163,
          "passage_sha256": "466ca44a2f1ea2f551887213d42bbadd69108f61ac47e8277bb5a1e0abd35721"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-outcomes-003",
        "statement": "In 2022 the main causes of preventable death were ischaemic heart disease (18%), alcohol-related disease (16%), and lung cancer and stroke (9% each).",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 11,
          "char_start": 65177,
          "char_end": 65342,
          "passage_sha256": "883c294aa1c4e18f0bdd1b62919dd85e4a02ed7a6cf81f41b57e3560797994f0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-outcomes-004",
        "statement": "Treatable mortality, deaths that timely care could mostly avert, was 201 per 100,000 in 2022, more than twice the EU average of 90.",
        "valence": "weakness",
        "source_id": "chp-lva-2025",
        "locator": {
          "page": 12,
          "char_start": 71984,
          "char_end": 72156,
          "passage_sha256": "3fe459a1f2a3e3ce233dfa2804912f9c871e7dc12ff34ecdedbf4e4f9ae7c3bd"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "LVA-outcomes-005",
        "statement": "In the GBD 2019 study, Latvia's Healthcare Access and Quality Index score for ages 0-74 was 69.5 (uncertainty interval 67.1-71.6) in 2019, 12.9 points above its 1990 level.",
        "valence": "neutral",
        "source_id": "gbd-haq-2019",
        "locator": {
          "section": "Full text",
          "char_start": 39079,
          "char_end": 39184,
          "passage_sha256": "82020ddba51d32974c9e3d157b1aca6ab8324658a028ee24d9873300b34e4a38"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
