    "access": [
      {
        "id": "EST-access-001",
        "statement": "In 2024, 11.2% of Estonians who needed care reported unmet needs from waiting times, cost or distance, against 3.6% in the EU; among people at risk of poverty the figures were 14.2% in Estonia and 6% in the EU (EU-SILC).",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 13,
          "char_start": 78221,
          "char_end": 78687,
          "passage_sha256": "c1a862e794d1164d9892cb53292dab05ed18265a1bcb8f8884ee3bb45a12027e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-access-002",
        "statement": "In 2024, 7% of Estonian adults reported unmet needs for primary care versus 3% in the EU (Eurofound), and satisfaction with access to family doctors, as measured by the insurance fund's survey, fell in 2023 to 76%, its lowest in six years.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 13,
          "char_start": 79406,
          "char_end": 79910,
          "passage_sha256": "c6a7fb2ef56377ab15f838d403832a65c7bfd71a806f0d30bff76df10173abf2"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-access-003",
        "statement": "Unmet needs for mental healthcare in Estonia rose from 5% of adults in 2021 to 11% in 2024, while the EU average rose from 3% to 7%.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 14,
          "char_start": 85044,
          "char_end": 85240,
          "passage_sha256": "662b36583c2cfe940dcedb08a3ff8def289c6c49c1d96d440fbad51aefb70901"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-access-004",
        "statement": "In 2023 Estonia had 3.5 physicians per 1,000 people against an EU average of 4.3, and 6.6 nurses per 1,000 against 8.5.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 9,
          "char_start": 48640,
          "char_end": 48862,
          "passage_sha256": "d90f70e373a4b243f913a6c1513165c1b5706df48a761664e2af18e022f62373"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "EST-access-005",
        "statement": "A 2023 primary care reform package included wider teleconsultation, more support for GPs in remote areas and nurse prescribing of medicines.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 13,
          "char_start": 79911,
          "char_end": 80439,
          "passage_sha256": "85e5523def5cf1a19f6098679a2a2e976e937e04783f02699a84d88d7edd4cbe"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "EST-access-006",
        "statement": "Under their contracts with the insurance fund, providers commit to keeping agreed waiting times and to international quality standards; the page does not report actual waiting times.",
        "valence": "neutral",
        "source_id": "tk-system-est",
        "locator": {
          "section": "Estonian health care system",
