      },
      {
        "id": "URY-access-002",
        "statement": "A 2023 decree added an exception tied to unmet waiting times: users may request a change of provider (from ASSE to a private provider, or between private providers) when they asked for the first available specialist, or when the deadline for coordinating surgery was exceeded.",
        "valence": "strength",
        "source_id": "junasa-2024",
