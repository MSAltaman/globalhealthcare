  "sections": {
    "overview": [
      {
        "id": "SVN-overview-001",
        "statement": "Slovenia runs a statutory, employment-based social health insurance system that offers universal coverage, with the Health Insurance Institute acting as the single purchaser of care.",
        "valence": "neutral",
        "source_id": "chp-svn-2025",
        "locator": {
          "section": "4 The health system",
          "page": 8,
          "char_start": 44970,
          "char_end": 45677,
          "passage_sha256": "b71b1a9af76236b70307951f95df0b125a037bd66edffe157fae75c7d8a8d161"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-overview-002",
        "statement": "Mandatory social health insurance was set up in 1992 and runs through one national fund, the Health Insurance Institute of Slovenia, which is funded mainly by payroll-based contributions and covers over 99% of the population.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "1. Introduction",
          "page": 18,
          "char_start": 26783,
          "char_end": 27083,
          "passage_sha256": "497e8dd2f70f226840e1a68a32f5a512c766628233e3b92cacb23435c733d874"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-overview-003",
        "statement": "Primary care is delivered through municipal community health centres with multidisciplinary teams, and GPs act as gatekeepers to specialist and hospital care; some private providers work inside the public system under contracts with the Health Insurance Institute.",
        "valence": "neutral",
        "source_id": "chp-svn-2025",
        "locator": {
          "section": "4 The health system",
          "page": 8,
          "char_start": 45678,
          "char_end": 46124,
          "passage_sha256": "3c93427722cb001a06f91c747cefab8ac1057d532a63e064ea33124d576a9c88"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-overview-004",
        "statement": "Entitlement to the full range of publicly financed care depends on legal residence and on paying the mandatory contributions to the Health Insurance Institute, and people must register in one of 25 entitlement categories.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.1 Population coverage",
          "page": 26,
          "char_start": 40300,
          "char_end": 40631,
          "passage_sha256": "db5500f6b5bd00221d3725022ced7817aba87900da5151b25e087c6a08c6b2ef"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      }
    ],
    "financing": [
      {
        "id": "SVN-financing-001",
        "statement": "In 2023 public sources paid 74% of current health spending in Slovenia, against an EU average of 80%; private sources made up the remaining 26%, of which voluntary health insurance, historically driven by complementary cover for co-payments, was 14%.",
        "valence": "neutral",
        "source_id": "chp-svn-2025",
        "locator": {
          "section": "4 The health system",
          "page": 8,
          "char_start": 46915,
          "char_end": 47172,
          "passage_sha256": "bd0d77cd917c3061dfd9bad8b80284b658a2614dda23cb804d45da0116ca8d6c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      },
      {
        "id": "SVN-financing-002",
        "statement": "WHO's figures put voluntary health insurance at 12% of current health spending in 2023, the highest share of any country in Europe.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.1 / Introduction",
          "page": 18,
          "char_start": 28274,
          "char_end": 28517,
          "passage_sha256": "a869ecc0cf35d1a667d46e8474ece01575d3fe63975b3cb3cd4615fa7350a661"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      },
      {
        "id": "SVN-financing-003",
        "statement": "Public spending on health was 7.1% of GDP in 2023, similar to the EU average but below countries with comparable income per person such as Czechia or Spain.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "1. Introduction",
          "page": 18,
          "char_start": 28702,
          "char_end": 28980,
          "passage_sha256": "912fef0c738d44e1e046ff27d632e07e4df867dd427ef15cbddf62714c7c2a9c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      },
      {
        "id": "SVN-financing-004",
        "statement": "Social health insurance contributions are the largest source of health revenue; they are set in the 1992 Health Care and Health Insurance Act and have stayed unchanged since 2002.",
        "valence": "neutral",
        "source_id": "hit-svn-2021",
        "locator": {
          "section": "3.3.2 Collection",
          "page": 83,
          "char_start": 157991,
          "char_end": 158212,
          "passage_sha256": "166cd58d43ec11e3bd5779b7089b9d4d40257b25b1493bc3c1fc86fdde429f0a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2020
      },
      {
        "id": "SVN-financing-005",
        "statement": "General national and municipal taxation pays for capital investment and national public health programmes such as cancer screening, and finances cover for socially vulnerable groups.",
        "valence": "neutral",
        "source_id": "hspm-svn-2022",
        "locator": {
          "section": "3.2 Sources of revenue and financial flows",
          "char_start": 3679,
          "char_end": 3905,
          "passage_sha256": "5ba35e72b4e66af352b3e81c14b1e407b8dcd4968d54b601af1619018b8b8eb1"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2021
      },
      {
        "id": "SVN-financing-006",
        "statement": "In 2023 roughly 45% of the population was covered through contributions paid on their own earnings, about 30% through state-paid contributions (for example pensioners, registered unemployed people and social benefit recipients) and about 25% as dependants.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.1 Population coverage",
          "page": 26,
          "char_start": 40632,
          "char_end": 41387,
          "passage_sha256": "bbf44b3f3357bc023d1fe95bf2db31605033a24a5f7231cca6408a9996a6a75a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      },
      {
        "id": "SVN-financing-007",
        "statement": "The compulsory health contribution is adjusted yearly in line with the previous year's average salary growth, and the state budget pays the contributions for socially vulnerable and other designated groups.",
        "valence": "neutral",
        "source_id": "chp-svn-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 14,
          "char_start": 90552,
          "char_end": 90806,
          "passage_sha256": "407eb970e7fce18eb9d72531bd74f7d151127369e8f5fda467988741684c5f9a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-financing-008",
        "statement": "In 2018 about 73% of residents held complementary voluntary insurance, and its premiums came to EUR 525.8 million, or 14% of total health spending.",
        "valence": "neutral",
        "source_id": "hspm-svn-2022",
        "locator": {
          "section": "3.2 Sources of revenue and financial flows",
          "char_start": 4383,
          "char_end": 4684,
          "passage_sha256": "0cae303a029041a40a0f0beb5528256dddf8726df4f9ac741cebd2d0739f2f2e"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2018
      },
      {
        "id": "SVN-financing-009",
        "statement": "Long-term care insurance funds are to be collected from employers and employees, who each contribute 1% of the worker's salary, with an additional EUR 190 million a year from the national budget.",
        "valence": "neutral",
        "source_id": "hspm-svn-2022",
        "locator": {
          "section": "3.2 Sources of revenue and financial flows",
          "char_start": 7960,
          "char_end": 8379,
          "passage_sha256": "fa600a0867998e945c33d5f72aad0485730f90f74de9f86e08a4e3bdfd57d734"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      },
      {
        "id": "SVN-financing-010",
        "statement": "Contribution rates are employment-based and levied on gross income; employees paid 6.36% of their gross income, as reported in the 2021 review.",
        "valence": "neutral",
        "source_id": "hit-svn-2021",
        "locator": {
          "section": "3.3.2 Collection",
          "page": 83,
          "char_start": 158213,
          "char_end": 158421,
          "passage_sha256": "37aed694c11c77479066b051eced466b47df9cfc197828b376e5c3b83361fdef"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2020
      },
      {
        "id": "SVN-financing-011",
        "statement": "As reported in the 2021 review, a 6.56% contribution covers illness and injury out of work and a further 0.53% covers work injuries and occupational disease; in total 13.45% of gross income is collected per insured person.",
        "valence": "neutral",
        "source_id": "hit-svn-2021",
        "locator": {
          "section": "3.3.2 Collection",
          "page": 84,
          "char_start": 160281,
          "char_end": 160447,
          "passage_sha256": "45289c74aeaa9fca88b42dc180c6e66e40134b3d7c5ae20f1b6e0dc45fa2b64b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2020
      },
      {
        "id": "SVN-financing-012",
        "statement": "A fixed monthly compulsory health contribution (EUR 37.17 in 2025) replaced complementary voluntary insurance premiums; it is raised on all incomes and paid in addition to regular rate-based social health insurance contributions, and children and students up to age 26 are exempt.",
        "valence": "neutral",
        "source_id": "chp-svn-2025",
        "locator": {
          "section": "5.2 Accessibility",
          "page": 14,
          "char_start": 90078,
          "char_end": 90550,
          "passage_sha256": "5b392a08f6ef6f2d2ff0cb1091731313384cc0fb9a246adc84259cd0579af36a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-financing-013",
        "statement": "Amendments to the Health Care and Health Insurance Act, adopted on 6 July 2023, ended complementary health insurance. From 1 January 2024 a fixed compulsory payment (initially EUR 35 monthly) is raised on all incomes, and the Ministry of Finance agreed to absorb possible shortfalls of up to EUR 240 million.",
        "valence": "neutral",
        "source_id": "hspm-svn-cohi",
        "locator": {
          "section": "Complementary health insurance abolished",
          "char_start": 661,
          "char_end": 1739,
          "passage_sha256": "dd5479174f16f6fe1375a4b5b999df9ae42bd2f18dc4c4c547e309a8e918f36d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2023
      }
    ],
    "covered": [
      {
        "id": "SVN-covered-001",
        "statement": "The publicly financed benefits package is set out broadly in the 1992 Act, is the same across the country, and includes dental care, orthodontics for children, physiotherapy and long-term care.",
        "valence": "strength",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.2 Service coverage",
          "page": 28,
          "char_start": 46686,
          "char_end": 47087,
          "passage_sha256": "563b87e208fbe0708bbff9ad51df3efbaeaaa95c9e87f17cca4e5f01060a5f17"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-20",
          "checked_by": "claude-opus (Opus subagent) support review"
        },
        "data_year": 2025
      },
      {
        "id": "SVN-covered-002",
        "statement": "Which medicines are covered is decided by the Minister of Health through positive and negative lists, and over-the-counter products are generally not covered.",
        "valence": "neutral",
        "source_id": "who-afford-svn-2025",
        "locator": {
          "section": "3.2 Service coverage",
          "page": 28,
          "char_start": 47088,
          "char_end": 47398,
