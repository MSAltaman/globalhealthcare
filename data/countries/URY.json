          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-006",
        "statement": "In 2024 capitation payments made up 75.4% of FONASA outlays and the goals (META) payments 4.9%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "page": 22,
          "char_start": 42376,
          "char_end": 42496,
          "passage_sha256": "bd6b0258e36e42b2561ccbe4510e131b318b33625e2d17685d53f46ab158260d"
