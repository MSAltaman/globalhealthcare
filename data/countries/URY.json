        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-cost_sharing-003",
        "statement": "In 2024 pharmacies were the largest destination of households' direct health spending (30% of the total), ahead of the mutual providers (26%).",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 18,
          "char_start": 25227,
          "char_end": 25459,
          "passage_sha256": "158de7b9c08557c8ac40f7433241b35c1e802637094fb6648c447cf2a85e07ce"
