        },
        "data_year": 2024
      }
    ],
    "outcomes": [
      {
        "id": "EST-outcomes-001",
        "statement": "Life expectancy at birth reached 79.6 years in 2024, which was 2.1 years below the EU average.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 4,
          "char_start": 13512,
          "char_end": 13649,
          "passage_sha256": "138572c17b44c23211c76a292de215b1e78a76da6ecb43a89aee34b5bab3065c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-outcomes-002",
        "statement": "In 2023, 30-year-old men with lower education had a life expectancy 10 years shorter than men with higher education, and the gap for women was 8.5 years.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 4,
          "char_start": 14097,
          "char_end": 14407,
          "passage_sha256": "86eab02346075cbf36236246475336728ee83435cdcb4defe28039fb4701cf1a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "EST-outcomes-003",
        "statement": "Preventable mortality fell 12%, from 304 deaths per 100,000 in 2012 to 267 in 2022, and alcohol caused a record 24% of preventable deaths.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 10,
          "char_start": 57151,
          "char_end": 57486,
          "passage_sha256": "a3b3cdc0fae72bfaf85e8c1ef49c5df9a2875d795d978e90c05115659390428b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
