  "sections": {
    "overview": [
      {
        "id": "ECU-overview-001",
        "statement": "The constitution declares health a right guaranteed by the State and says health services are to be governed by principles that include equity, universality, solidarity, interculturalism, quality, efficiency, effectiveness and prevention.",
        "valence": "neutral",
        "source_id": "const-ecu",
        "locator": {
          "section": "Article 32",
          "char_start": 22499,
          "char_end": 23257,
          "passage_sha256": "f48f872bce9ca9573466e73216b9699c8824ba5a090a1b5496a3aa92bf06f93d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-overview-002",
        "statement": "The constitution says health care is a public service delivered through state, private, autonomous and community institutions, including those practising alternative and ancestral medicine.",
        "valence": "neutral",
        "source_id": "const-ecu",
        "locator": {
          "section": "Article 362",
          "char_start": 289327,
          "char_end": 289520,
          "passage_sha256": "c1b8cb9d5d89852350b66d489e998603f24a6575c7f848436236aeeb046a0e27"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-overview-003",
        "statement": "Everyone in Ecuador has public health coverage either from a public insurer or from the Ministry of Public Health: the IESS covers affiliated workers and dependants, retirees and, through the Seguro Social Campesino, rural people and artisanal fishers; military and police regimes cover their members; and the Ministry covers people with no affiliation or social security entitlement.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 6399,
          "char_end": 7263,
          "passage_sha256": "c93c718c17ad0fca16debb635d6a1b3430b3e58467d74ef073a93f5e5603fa5d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-overview-004",
        "statement": "The Public Comprehensive Health Network was formed through a framework agreement among the Ministry of Public Health, the social security institutes of IESS, the armed forces and the police, and the defence and interior ministries.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 1,
          "char_start": 3517,
          "char_end": 3932,
          "passage_sha256": "9e1ef4f0e188ba6cd0ff89d581e98da80094fbfa83eea8a9fde80d0aa2aaec8d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-overview-005",
        "statement": "Public network institutions are the largest providers, with 80% of health establishments public; most are non-inpatient facilities belonging to the Ministry of Public Health.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 5873,
          "char_end": 6219,
          "passage_sha256": "3808f2a6ab493f0542d14db58d8dca45fd39298c8c07cf21861fc85d376d9ff7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2018
      },
      {
        "id": "ECU-overview-006",
        "statement": "In 2023 only 23.3% of Ecuador's population had social insurance and 10% had private insurance, so roughly two thirds, about 11.3 million people, relied on the Ministry of Public Health as their main provider.",
        "valence": "neutral",
        "source_id": "pmc-12925043",
        "locator": {
          "section": "Introduction",
          "char_start": 6102,
          "char_end": 6327,
          "passage_sha256": "811aea6fb80aa014334d027e29e5bb7f879c7628a243727cff53755c9fd5394f"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2023
      }
    ],
    "financing": [
      {
        "id": "ECU-financing-001",
        "statement": "The health system is financed from the state budget, social security contributions of workers and employers (including the military and police regimes), households' direct spending, and external cooperation funds.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Fuentes de ingresos",
          "page": 3,
          "char_start": 15041,
          "char_end": 15368,
          "passage_sha256": "47ac1b08827f81fb97ab539e1051db28eae08149873ca9dd8c904da8db12f362"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-financing-002",
        "statement": "Tax-funded state budget resources go mainly to the Ministry of Public Health to pay for care of people without social security affiliation or coverage.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Fuentes de ingresos",
          "page": 3,
          "char_start": 9133,
          "char_end": 9331,
          "passage_sha256": "e6c83287718a8192eb72145980da74cb3feeb525d1c17d122ee3d0c752fa8c4c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-financing-003",
        "statement": "For private-sector workers, bank employees and employees of decentralised governments, the employer contribution to the IESS health insurance is 5.16%.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Fuentes de ingresos",
          "page": 3,
          "char_start": 10972,
          "char_end": 11147,
          "passage_sha256": "4a720fcba039008dc3d420d4ad3e6eea5923f5f0418ccec3b3ae09a5e7b68e82"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-financing-004",
        "statement": "Armed forces sickness and maternity insurance is funded by 3.35% from active personnel and 5.85% from the employer; for the National Police the rates are 2.5% from the member and 3% from the employer.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Fuentes de ingresos",
          "page": 3,
          "char_start": 11597,
          "char_end": 11915,
          "passage_sha256": "1cce32ed39cdf63f322877bf172c9eb881963f342ca9f2a73e8f50d5a67a75e5"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-financing-005",
        "statement": "Under the social security law the State pays for the health benefits of IESS retirees, people with disabilities, female heads of household and treatment of catastrophic illness through a mandatory financial contribution.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Fuentes de ingresos",
          "page": 3,
          "char_start": 10083,
          "char_end": 10397,
          "passage_sha256": "6b37b82973da299d993f9eaa254f02cdd0b649b31f1a46b773cbc271a658324f"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-financing-006",
        "statement": "The ILO note says resources are allocated to providers in a public network on the basis of historical budgets, and that the allocation criteria are not explicit.",
        "valence": "weakness",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Gestión de recursos",
          "page": 4,
          "char_start": 16809,
          "char_end": 17142,
          "passage_sha256": "f7df7388f8a7e894c883603f262ae4f20cb98604ceeccec470e63c834b276456"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      }
    ],
    "covered": [
      {
        "id": "ECU-covered-001",
        "statement": "Care is organized in three levels: first-level primary care as the entry point, second-level specialist outpatient and inpatient care, and third-level highly complex specialist care.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 4786,
          "char_end": 5184,
          "passage_sha256": "e8c43a7d15a3c1e059287f64af181927885439f91a7112d50e33e7b893c65447"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-covered-002",
        "statement": "The IESS covers affiliates, whether employees or self-employed, their dependants under 18 and spouse, unpaid household workers, voluntary affiliates and retirees.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 6530,
          "char_end": 6825,
          "passage_sha256": "c364f62d7cb7213026c26817441784234c9402f2d855ed44531d281dd42825d7"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-covered-003",
        "statement": "The Ministry of Public Health covers people who have no affiliation or entitlement under the social security regimes.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 7114,
          "char_end": 7263,
          "passage_sha256": "6f36521733745760a07507c173a535cc84928cc58322b2c87fef200816412608"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": 2021
      },
      {
        "id": "ECU-covered-004",
        "statement": "The authors conclude that the 2007-2017 Ecuadorian reform widened universal coverage through fee removal, a stronger first level of care and support for intercultural health.",
        "valence": "strength",
        "source_id": "jcsh-1146",
        "locator": {
          "section": "Abstract, conclusion",
          "char_start": 2790,
          "char_end": 2933,
          "passage_sha256": "7d386ba5b562a3b6c2093bc2b1894c59a41e21c2385f5cafc0da1aa06aa76f2c"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-23",
          "checked_by": "claude-opus support review"
        },
        "data_year": "2007-2017"
      },
      {
        "id": "ECU-covered-005",
        "statement": "The ILO note says the national health system is guided by a comprehensive care model that brings family, community and intercultural approaches into the system and includes a renewed primary care strategy.",
        "valence": "neutral",
        "source_id": "ilo-ecu-2024",
        "locator": {
          "section": "Estructura del Sistema de Salud",
          "page": 2,
          "char_start": 5402,
          "char_end": 5736,
          "passage_sha256": "a6e070074de25df6cd2dad08a199abf5a39289491d20ef0e03ec2a2d66e1055e"
        },
        "verification": {
