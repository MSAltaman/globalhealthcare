      {
        "id": "URY-what_works-004",
        "statement": "PAHO's review reports that since the start of the reform out-of-pocket spending fell from 23% to 15% of health spending (2019 ministry data), placing Uruguay among the few countries in the region within PAHO's thresholds of 6% of GDP for public health spending and 20% for out-of-pocket spending.",
        "valence": "strength",
        "source_id": "paho-func-ury",
        "locator": {
