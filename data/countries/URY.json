  "sections": {
    "overview": [
      {
        "id": "URY-overview-001",
        "statement": "The National Integrated Health System (SNIS) was created by Law 18,211 of December 2007; it integrates public and private providers and is financed through the National Health Fund (FONASA), a single mandatory public fund.",
        "valence": "neutral",
        "source_id": "paho-func-ury",
        "locator": {
          "page": 2,
          "char_start": 356,
          "char_end": 640,
          "passage_sha256": "a7211013fd07b57a07cfff75c0b711cb5853a4fcd887d5e38ca182d280b8c39f"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2021
      },
      {
        "id": "URY-overview-002",
        "statement": "At the end of 2024 the National Health Insurance covered 2,681,295 people, roughly three quarters of the national population.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "page": 15,
          "char_start": 19711,
          "char_end": 19879,
          "passage_sha256": "22d7f424f901803c8e47e996f81602aefa73557f884bf5d2fd41ca87800d7f36"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2024
      },
      {
        "id": "URY-overview-003",
        "statement": "In December 2024 the mutual subsector represented 74.6% of the total coverage counted in the JUNASA report, ASSE 21.9% and the insurers 3.4%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "page": 11,
          "char_start": 22142,
          "char_end": 22727,
          "passage_sha256": "7831abd584de3ab039e02523f6ec6c0175cf318c4001dc67f41bd0a83e580aff"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2024
      },
      {
        "id": "URY-overview-004",
        "statement": "As of 2021 the SNIS ensured universal coverage through 42 eligible comprehensive health providers, which deliver the Comprehensive Health Care Plan (PIAS), a broad benefits plan that is the same for all.",
        "valence": "neutral",
        "source_id": "paho-func-ury",
        "locator": {
          "page": 2,
          "char_start": 768,
          "char_end": 994,
          "passage_sha256": "0852f25c0896bebe8dbf7979559f1d1e3e5d596dc5b9a8a26be3a48b4da3c2a9"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2021
      }
    ],
    "financing": [
      {
        "id": "URY-financing-001",
        "statement": "FONASA obligations consist of personal contributions that vary with pay and family situation, employer contributions at a 5% rate, and the mutual-fee complement (CCM) where it applies.",
        "valence": "neutral",
        "source_id": "bps-tasas-fonasa",
        "locator": {
          "section": "Web page, rates tables",
          "char_start": 151,
          "char_end": 396,
          "passage_sha256": "c5c6a4a517107f7f2f1028f5ea5586f8378b5368191e40bd5201c108c97def48"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2026
      },
      {
        "id": "URY-financing-002",
        "statement": "Employees pay a basic 3% personal rate plus an additional rate set by pay band and family situation. For pay up to 2.5 BPC the total is 3% or 5% (5% for those with a spouse or partner); above 2.5 BPC it ranges from 4.5% to 8% depending on spouse and children.",
        "valence": "neutral",
        "source_id": "bps-tasas-fonasa",
        "locator": {
          "section": "Web page, rates tables",
          "char_start": 538,
          "char_end": 1239,
          "passage_sha256": "730899d4669c6810024eb33e029fc31b3cb1bfa34d9be62e24f2c6fab65ddade"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2026
      },
      {
        "id": "URY-financing-003",
        "statement": "In 2024 FONASA's own income was 78.1% of its total revenue of about 147.7 billion pesos; a transfer from general revenue supplied the other 21.9%.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "page": 21,
          "char_start": 39949,
          "char_end": 40992,
          "passage_sha256": "80a8229ba579cd1ae85e616f2a6cbe472bd3e552412a58ff2058d52f345577c6"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-004",
        "statement": "Of FONASA's own income in 2024, about 43.4% came from personal contributions of private- and public-sector employees (excluding banking, notarial and self-employed contributors), a little over 36% from employer contributions and mutual-fee complements, and 12.6% from contributions by retirees and pensioners.",
        "valence": "neutral",
        "source_id": "junasa-2024",
        "locator": {
          "page": 21,
          "char_start": 40993,
          "char_end": 41874,
          "passage_sha256": "4fb61a988391040039414400980356bf6b6bfbcd8d36b72df07c189154d89c25"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pass",
          "checked_on": "2026-11-22",
          "checked_by": "claude-opus support review (passage vs. statement)"
        },
        "data_year": 2024
      },
      {
        "id": "URY-financing-005",
        "statement": "Government schemes and compulsory contributory insurance together financed 72.6% of total health spending in 2023 and 73.7% in 2024.",
        "valence": "neutral",
        "source_id": "msp-cns-2024",
        "locator": {
          "page": 13,
          "char_start": 15925,
          "char_end": 16278,
          "passage_sha256": "73493950e1f6bdcefbb72d53180580efd15ed82e6cd0dc043b070c42b9043b84"
        },
        "verification": {
          "passage_found": "pass",
