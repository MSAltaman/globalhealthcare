    "what_works": [
      {
        "id": "URY-what_works-001",
        "statement": "The health ministry reports that out-of-pocket spending has been below 20% of health spending since 2008 and public health spending above 6% of GDP since 2015, meeting both PAHO-recommended thresholds.",
        "valence": "strength",
        "source_id": "msp-cns-2024",
        "locator": {
          "section": "see page",
          "page": 6,
          "char_start": 7175,
          "char_end": 7372,
          "passage_sha256": "cc37c09d630a309ed7ab4d2bc2f59f0296a7e91fdd19b6febb48f3d36bec1926"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2024
      },
      {
        "id": "URY-what_works-002",
        "statement": "A 2020 study reported that, by pooling payroll contributions and allocating by health risk, the reform narrowed the gap in resources per member between ASSE and the mutual providers from 3.5 times in 2005 to 1.3 in 2012.",
        "valence": "strength",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 31132,
          "char_end": 31233,
          "passage_sha256": "9c49b479ce5a1b6d68c96b96ff90b28b7a3b954db585c2bef388a4073782609b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-22"
        },
        "data_year": 2012,
        "historical": true
      },
      {
        "id": "URY-what_works-003",
        "statement": "A 2020 study concluded that Uruguay's reform reinforced the public system and promoted financial solidarity by pooling and progressively allocating resources.",
        "valence": "strength",
        "source_id": "equity-seg-2020",
        "locator": {
          "section": "see page",
          "char_start": 3891,
          "char_end": 4028,
          "passage_sha256": "ef2071d873d6a6ff3546144924b318274e30ce652c477e38672cf241b0c6319c"
        },
