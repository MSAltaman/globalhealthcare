        },
        "data_year": "2006-2014",
        "historical": true
      },
      {
        "id": "ECU-financial_hardship-002",
        "statement": "Catastrophic health expenditure among households fell from 17% in 2006 to 10% in 2014, with falls in every socioeconomic group studied.",
        "valence": "strength",
        "source_id": "pmc-12314978",
        "locator": {
          "section": "Abstract",
          "char_start": 2725,
          "char_end": 3345,
          "passage_sha256": "cd8c576fc538ac1bae4255525bb1ddddd9628a0fc8b3869ae1230cff777f4fe6"
