{
  "iso3": "EST",
  "name": "Estonia",
  "wave": 4,
  "system_as_of": "2026-11-20",
  "status": "draft",
  "model": {
    "type": "social_health_insurance",
    "label": "Single national social health insurance fund financed by an earmarked 13% payroll tax plus state transfers; entitlement is tied to employment or contributions, with automatic cover for children and pensioners"
  },
  "universal_coverage": {
    "legal_basis_claim_ids": [
      "EST-covered-001",
      "EST-covered-002"
    ],
    "meets_definition": false
  },
  "sections": {
    "overview": [
      {
        "id": "EST-overview-001",
        "statement": "Estonia's system is mandatory social health insurance, funded mainly by a payroll tax of 13% of gross wages that is earmarked for health, with state transfers added for people outside work.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 8,
          "char_start": 43275,
          "char_end": 43532,
          "passage_sha256": "55f493aca7d9b5bc1bb8350797043cdd3be0d3fdf049ec89a3196b3f58d4c62a"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "EST-overview-002",
        "statement": "One national insurer, the Estonian Health Insurance Fund (EHIF), pools and manages public health money; the Ministry of Social Affairs oversees the system and municipalities own public hospitals.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 8,
          "char_start": 43533,
          "char_end": 43954,
          "passage_sha256": "ce3689da8c284b9cc0a3971a8b76c410c1ddd357288b2c7643b45c8f3078bf78"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "EST-overview-003",
        "statement": "Hospital care and most outpatient specialist care come from publicly owned hospitals, while family doctors and dentists mostly work as private entrepreneurs.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 8,
          "char_start": 43955,
          "char_end": 44220,
          "passage_sha256": "0dfcb2bc6bd8c7b6cd0e400d5d95fbdf7cd4a2d39f41e19e6627c116805b44cb"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "EST-overview-004",
        "statement": "The insurance fund states that, in its unified national scheme, contributions and access to necessary care do not depend on age, income or health risk.",
        "valence": "neutral",
        "source_id": "tk-system-est",
        "locator": {
          "section": "Estonian health care system",
          "char_start": 335,
          "char_end": 665,
          "passage_sha256": "b6c3574211308c34db9e9d0be99c58e4b2d7976261993f8fe330a0c5377abee4"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      }
    ],
    "financing": [
      {
        "id": "EST-financing-001",
        "statement": "The Health Insurance Fund's income comes from the health-insurance portion of the social tax, which is 13%; it uses this to pay providers under contracts.",
        "valence": "neutral",
        "source_id": "tk-system-est",
        "locator": {
          "section": "Estonian health care system",
          "char_start": 2674,
          "char_end": 2777,
          "passage_sha256": "73a1e9d7e50f01a6444737c4f6ac7a6b15dd5c48434d925d11cedf07623e3085"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-financing-002",
        "statement": "The social tax rate is 33% in total; self-employed people pay it on their business income after allowed deductions, within a minimum and a maximum set by the Social Tax Act.",
        "valence": "neutral",
        "source_id": "emta-selfemployed",
        "locator": {
          "section": "Social tax, principles",
          "char_start": 1359,
          "char_end": 1803,
          "passage_sha256": "d75c107a640dc5df79425b4643ceca0e82bd9c17dff98485d8675481fab63f64"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "EST-financing-003",
        "statement": "For 2026 the monthly minimum base for social tax is 886 euros, so at least 292.38 euros of social tax a month must be declared for people on service-type contracts to keep health insurance cover.",
        "valence": "neutral",
        "source_id": "tk-employee",
        "locator": {
          "section": "Persons receiving remuneration or service fees under a contract under the law of obligations",
          "char_start": 3472,
          "char_end": 3814,
          "passage_sha256": "932af825d1f007d05eb805588a071e32034177f36cb4c0804e95d631b092dfd0"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "EST-financing-004",
        "statement": "In 2023 public funds paid for 76% of current health spending, with the insurance fund covering 67% and central government 5% (down from 7% in 2022); out-of-pocket payments made up 22%.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 8,
          "char_start": 44890,
          "char_end": 45283,
          "passage_sha256": "fe394aa09028ccb1348e4b7547e29cdb27893f74781c5e7a4bf9d8bb58284aa8"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "EST-financing-005",
        "statement": "As of the 2022 summary, about two thirds of funding came from the earmarked 13% payroll tax, and direct state transfers to the insurance fund, including for non-working pensioners and extra pandemic transfers, were a growing share.",
        "valence": "neutral",
        "source_id": "hit-est-2022",
        "locator": {
          "page": 4,
          "char_start": 5265,
          "char_end": 5959,
          "passage_sha256": "2edd1dbf10c504276fb851fc343644cff2e1cac990bfc0d0e06a2d9b9d12af91"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      }
    ],
    "covered": [
      {
        "id": "EST-covered-001",
        "statement": "An estimated 94% of the population had social health insurance in 2024. Children and pensioners are enrolled automatically, but working-age adults qualify mainly through employment, and only 88% of those aged 20-59 were covered.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 14,
          "char_start": 85717,
          "char_end": 86148,
          "passage_sha256": "2bdd6654bda50b604b42257ac71e578c23131414585a9fc5949aee59a36de6eb"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-covered-002",
        "statement": "People with insurance receive a broad package of benefits. Those without it are limited to emergency care, cancer screening, drug-cessation and substitution services, and treatment of certain communicable diseases.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 14,
          "char_start": 86149,
          "char_end": 86364,
          "passage_sha256": "650e5397089a2ac320e1342fae9afbbdd74a9a95a186df9b3153a803f49fe443"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        }
      },
      {
        "id": "EST-covered-003",
        "statement": "Employees on an employment contract of over a month, or an open-ended one, whose employer pays social tax become insured after a 14-day waiting period from the start date registered in the employment register.",
        "valence": "neutral",
        "source_id": "tk-employee",
        "locator": {
          "section": "Employees working under an employment contract",
          "char_start": 945,
          "char_end": 1307,
          "passage_sha256": "c7930a09be2e9ab63405ae6c93a9d2ef1ef3a90bcdd0ae43418d6c83077e7e86"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2026
      },
      {
        "id": "EST-covered-004",
        "statement": "The insurance fund updates the benefits package and prices at least yearly, covering over 2,800 health services and DRGs, about 2,200 pharmaceuticals and 2,100 medical products; the government approves the benefits.",
        "valence": "neutral",
        "source_id": "hit-est-2022",
        "locator": {
          "page": 3,
          "char_start": 2896,
          "char_end": 3168,
          "passage_sha256": "1fa4bd4f80fe3efd8c652da0567aa5682008531a306e7401b69744c21c949643"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      },
      {
        "id": "EST-covered-005",
        "statement": "The fund says the list of reimbursable healthcare services is updated annually in line with needs and financial capacity, taking into account evidence and cost-effectiveness.",
        "valence": "neutral",
        "source_id": "tk-system-est",
        "locator": {
          "section": "What is the list of healthcare services",
          "char_start": 6506,
          "char_end": 6795,
          "passage_sha256": "5bfff8ce58aeb0c9029512a84154d5f4cec0f4342d32f01158de064b33d5cdac"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2024
      },
      {
        "id": "EST-covered-006",
        "statement": "Teleconsultations in primary and specialist outpatient care, first introduced during the COVID-19 pandemic, have become a permanent part of the reimbursed benefits package since 2020.",
        "valence": "strength",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 16,
          "char_start": 101170,
          "char_end": 101458,
          "passage_sha256": "d87d08ef2a40033d94028e656a555c59b0d9ee7abe7f6a8357600ad003bdb129"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      }
    ],
    "cost_sharing": [
      {
        "id": "EST-cost_sharing-001",
        "statement": "In April 2025 the fee for an outpatient specialist consultation rose from 5 to 20 euros and the daily inpatient fee from 2.50 to 5 euros.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 15,
          "char_start": 93580,
          "char_end": 93730,
          "passage_sha256": "8759b18550a5b3ff7ac459cc46cc20ee2fec4df0dcbfa75c9061d7b340b5ba12"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "EST-cost_sharing-002",
        "statement": "The fixed fee per prescription medicine increased from 2.50 to 3.50 euros in 2025.",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 21,
          "char_start": 135298,
          "char_end": 135388,
          "passage_sha256": "0db5b6be914d6ec97ad697cee82b5023046eebd858c26eb62e599f1e36b130fd"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2025
      },
      {
        "id": "EST-cost_sharing-003",
        "statement": "Out-of-pocket payments were 22% of current health spending in 2023; dental care was the largest part of that (33%, the highest share in the EU), followed by pharmaceuticals (28%) and long-term care (18%).",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 15,
          "char_start": 92853,
          "char_end": 93206,
          "passage_sha256": "42d6a5937467c717f82f266080b49b3975ccc0f758c57bbafe2ebd131289bc9b"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "EST-cost_sharing-004",
        "statement": "In 2023, public funds covered 99% of hospital spending (EU average 91%) and 84% of outpatient medical spending (EU average 77%), before the 2025 fee increases.",
        "valence": "strength",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 14,
          "char_start": 86463,
          "char_end": 86778,
          "passage_sha256": "f631d7df61d7a5a42e81aac36e60624e9f87fc4371c2abadbb85595257ebe187"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2023
      },
      {
        "id": "EST-cost_sharing-005",
        "statement": "A 2017 dental package, extended in 2019, covers basic dental services for all adults with a 50% copayment and a 40-euro annual reimbursement cap.",
        "valence": "neutral",
        "source_id": "hit-est-2022",
        "locator": {
          "page": 11,
          "char_start": 23190,
          "char_end": 23314,
          "passage_sha256": "cdce1d8c1358b7e929df60a327e8fececbe5aff08da96112a694aefe6f30c9f3"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2022
      }
    ],
    "financial_hardship": [
      {
        "id": "EST-financial_hardship-001",
        "statement": "A 2023 WHO/Europe study found that financial hardship from health costs eased between 2015 and 2020. Hardship is chiefly caused by out-of-pocket spending on outpatient medicines and dental care, and falls mostly on low-income households.",
        "valence": "weakness",
        "source_id": "who-news-est-2023",
        "locator": {
          "section": "News release, 12 December 2023",
          "char_start": 1280,
          "char_end": 1457,
          "passage_sha256": "41662bd3fb76a3e45dc5a1544b6fdfefd4ca50f5a6ab81e4e4df86a1bcc61ac5"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      },
      {
        "id": "EST-financial_hardship-002",
        "statement": "Outpatient medicines made up nearly 59% of all out-of-pocket health payments in 2020, and catastrophic spending on them was split almost evenly between over-the-counter medicines (30%) and prescribed medicines (29%).",
        "valence": "weakness",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 20,
          "char_start": 128161,
          "char_end": 128461,
          "passage_sha256": "1288a73dc69f09f139b3d2b9d04b9e779bbc071e31534e6990cf9211714f0c0d"
        },
        "verification": {
          "passage_found": "pass",
          "supports": "pending",
          "checked_on": "2026-11-20"
        },
        "data_year": 2020
      }
    ],
    "additional_care": [
      {
        "id": "EST-additional_care-001",
        "statement": "Voluntary health insurance plays a small role, at 2% of health spending in 2023.",
        "valence": "neutral",
        "source_id": "chp-est-2025",
        "locator": {
          "page": 8,
          "char_start": 45284,
          "char_end": 45394,
          "passage_sha256": "7b9fb8b6c30698db026a0714923e60e81cf5240b319f0cfd84d4d5f71d10793a"
